@model IEnumerable<ManejoPresupuestos.Models.UsuarioListaVm>

@{
    ViewData["Title"] = "Usuarios";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
        --danger: #EF4444;
        --success: #16A34A;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
        font-size: clamp(2rem, 1.45rem + 1.2vw, 2.6rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
        max-width: 90ch;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-pill.btn-sm{
        padding: .40rem .78rem;
        font-size: .84rem;
    }
    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }

    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .btn-danger-soft{
        background: rgba(239,68,68,.10);
        border-color: rgba(239,68,68,.20);
        color: #B91C1C;
    }
    .btn-danger-soft:hover{
        background: rgba(239,68,68,.14);
        border-color: rgba(239,68,68,.24);
        color: #991B1B;
    }

    .btn-success-soft{
        background: rgba(22,163,74,.10);
        border-color: rgba(22,163,74,.20);
        color: #166534;
    }
    .btn-success-soft:hover{
        background: rgba(22,163,74,.14);
        border-color: rgba(22,163,74,.24);
        color: #14532D;
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .table-clean{ margin: 0; }
    .table-clean thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        padding: .70rem .90rem;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }
    .table-clean tbody td{
        padding: .62rem .90rem;
        border-top: 1px solid rgba(15,23,42,.06);
        vertical-align: middle;
        font-size: .95rem;
    }

    .chip{
        display:inline-flex;
        align-items:center;
        padding: .30rem .58rem;
        border-radius: 999px;
        font-weight: 850;
        font-size: .78rem;
        border: 1px solid rgba(15,23,42,.12);
        background: rgba(15,23,42,.03);
        color: var(--text);
        margin-right: .35rem;
        margin-bottom: .25rem;
        max-width: 100%;
    }

    .state-pill{
        display:inline-flex;
        align-items:center;
        padding: .32rem .62rem;
        border-radius: 999px;
        font-weight: 900;
        font-size: .78rem;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        color: var(--text);
        white-space: nowrap;
    }
    .state-pill.on{
        border-color: rgba(22,163,74,.22);
        background: rgba(22,163,74,.10);
        color: #166534;
    }
    .state-pill.off{
        border-color: rgba(100,116,139,.22);
        background: rgba(100,116,139,.10);
        color: #334155;
    }
    .state-pill.admin{
        border-color: rgba(15,23,42,.18);
        background: rgba(15,23,42,.06);
        color: #0F172A;
    }

    .actions-wrap{
        display:flex;
        justify-content:flex-end;
        gap:.45rem;
        flex-wrap:wrap;
        white-space: nowrap;
    }

    .cell-muted{ color: var(--muted); }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Usuarios</h1>
                <div class="pg-subtitle">Administra usuarios, roles y permisos por módulo.</div>
            </div>

            <button class="btn btn-primary btn-pill btn-primary-pill" onclick="openUsuarioModal(null)">
                Nuevo usuario
            </button>
        </div>

        <div class="card card-soft">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-clean align-middle">
                        <thead>
                            <tr>
                                <th style="width:220px;">Estado</th>
                                <th style="min-width:220px;">Nombre</th>
                                <th style="min-width:260px;">Email</th>
                                <th style="min-width:320px;">Permisos</th>
                                <th class="text-end" style="width:240px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="state-pill @(u.EstaActivo ? "on" : "off")">
                                            @(u.EstaActivo ? "Activo" : "Inactivo")
                                        </span>
                                        @if (u.EsAdmin)
                                        {
                                            <span class="state-pill admin ms-2">Admin</span>
                                        }
                                    </td>

                                    <td class="fw-semibold">@u.Nombre</td>

                                    <td class="cell-muted">@u.Email</td>

                                    <td>
                                        @foreach (var p in u.PermisosList)
                                        {
                                            <span class="chip">@p</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="actions-wrap">
                                            <button class="btn btn-pill btn-soft btn-sm" onclick="openUsuarioModal(@u.Id)">
                                                Editar
                                            </button>

                                            @if (u.EstaActivo)
                                            {
                                                <button class="btn btn-pill btn-danger-soft btn-sm" onclick="toggleUsuario(@u.Id,false)">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-pill btn-success-soft btn-sm" onclick="toggleUsuario(@u.Id,true)">
                                                    Activar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="usuarioModalHost"></div>

    </div>
</div>

@section Scripts {
<script>
    async function openUsuarioModal(id){
        const url = id ? `/Usuarios/Form?id=${id}` : `/Usuarios/Form`;
        const html = await fetch(url).then(r => r.text());
        document.getElementById('usuarioModalHost').innerHTML = html;

        const modalEl = document.getElementById('usuarioModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    async function submitUsuarioForm(ev){
        ev.preventDefault();
        const form = ev.target;
        const data = new FormData(form);

        const resp = await fetch(form.action, {
            method: 'POST',
            body: data
        });

        const res = await resp.json();
        if(res.result === 'success'){
            location.reload();
            return;
        }
        alert(res.message || 'Error');
    }

    async function toggleUsuario(id, activar){
        if(!confirm(activar ? '¿Activar usuario?' : '¿Desactivar usuario?')) return;

        const token = document.querySelector('#usuarioAntiForgery input[name="__RequestVerificationToken"]').value;
        const data = new FormData();
        data.append('__RequestVerificationToken', token);
        data.append('id', id);
        data.append('activar', activar);

        const resp = await fetch('/Usuarios/CambiarEstado', { method:'POST', body:data });
        const res = await resp.json();

        if(res.result === 'success'){
            location.reload();
            return;
        }
        alert(res.message || 'Error');
    }
</script>

<form id="usuarioAntiForgery" style="display:none;">
    @Html.AntiForgeryToken()
</form>
}