@{
    ViewData["Title"] = "Acceso denegado";
}

<h2>Acceso denegado</h2>
<p>No tienes permisos para acceder a esta sección.</p>

<div class="d-flex gap-2">
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ir al inicio</a>
    @if (!string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string))
    {
        <a class="btn btn-outline-secondary" href="@ViewBag.ReturnUrl">Intentar de nuevo</a>
    }
</div>