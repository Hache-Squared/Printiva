<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManejoPresupuestos.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        :root{
            --pg-bg: #F6F7FB;
            --card-bg: rgba(255,255,255,.96);
            --text: #0F172A;
            --muted: #64748B;
            --border: rgba(15,23,42,.10);
            --border2: rgba(15,23,42,.08);

            --primary: #1D4ED8;
            --success: #16A34A;
            --warning: #F59E0B;

            --shadow: 0 12px 34px rgba(2,6,23,.10);
            --radius: 18px;
        }

        body{
            margin: 0;
            background:
                radial-gradient(1200px 600px at 20% 20%, rgba(29,78,216,.08), transparent 60%),
                radial-gradient(900px 500px at 80% 35%, rgba(22,163,74,.07), transparent 60%),
                var(--pg-bg);
            color: var(--text);
        }

        .auth-wrap{
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.25rem 1.25rem;
        }

        .auth-shell{
            width: 100%;
            max-width: 1120px;
        }

        .brand-row{
            display: flex;
            align-items: center;
            gap: 1.15rem;
        }

        .brand-mark{
            width: 64px;
            height: 64px;
            border-radius: 16px;
            border: 1px solid var(--border2);
            background: rgba(255,255,255,.9);
            box-shadow: 0 10px 24px rgba(2,6,23,.06);
            display: grid;
            place-items: center;
            overflow: hidden;
        }

        .brand-mark img{
            width: 38px;
            height: 38px;
            object-fit: contain;
        }

        .brand-title{
            margin: 0;
            font-weight: 950;
            letter-spacing: -.03em;
            font-size: 1.55rem;
            line-height: 1.05;
        }

        .brand-subtitle{
            margin: .25rem 0 0 0;
            color: var(--muted);
            font-size: .95rem;
        }

        .info-card{
            margin-top: 1.35rem;
            background: var(--card-bg);
            border: 1px solid var(--border2);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1rem 1rem;
        }

        .info-title{
            margin: 0;
            font-weight: 900;
            font-size: .92rem;
            color: var(--text);
        }

        .info-sub{
            margin-top: .25rem;
            color: var(--muted);
            font-size: .9rem;
        }

        .chip{
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .32rem .62rem;
            border-radius: 999px;
            font-weight: 900;
            font-size: .78rem;
            border: 1px solid var(--border2);
            background: rgba(255,255,255,.78);
            color: var(--text);
        }

        .chip-primary{
            border-color: rgba(29,78,216,.22);
            background: rgba(29,78,216,.08);
            color: #1D4ED8;
        }
        .chip-success{
            border-color: rgba(22,163,74,.22);
            background: rgba(22,163,74,.08);
            color: #166534;
        }
        .chip-warning{
            border-color: rgba(245,158,11,.25);
            background: rgba(245,158,11,.10);
            color: #92400E;
        }

        .auth-footer{
            text-align: center;
            color: var(--muted);
            font-size: .78rem;
            margin-top: 1.2rem;
        }

        @@media (max-width: 991.98px){
            .brand-col{
                text-align: center;
            }
            .brand-row{
                justify-content: center;
            }
            .info-card{
                max-width: 520px;
                margin-left: auto;
                margin-right: auto;
            }
        }
    </style>
</head>
<body>

    <div class="auth-wrap">
        <div class="auth-shell">
            <div class="row g-4 align-items-center justify-content-center">
                <div class="col-lg-6 brand-col">
                    <div class="brand-row">
                        <div class="brand-mark">
                            <img src="/logo.png" alt="Logo de Printiva" />
                        </div>
                        <div>
                            <h2 class="brand-title">Print3D</h2>
                            <div class="brand-subtitle">Sistema de manejo de finanzas y unidades.</div>
                        </div>
                    </div>

                    <div class="info-card">
                        <div class="info-title">Acceso rápido</div>
                        <div class="info-sub">Entra con tu cuenta para ver compras, inventario y reportes.</div>

                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <span class="chip chip-primary">Inventario</span>
                            <span class="chip chip-success">Produccion</span>
                            <span class="chip chip-warning">Costeo</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-xl-5">
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>

            <div class="auth-footer">Print3D · Panel interno</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>