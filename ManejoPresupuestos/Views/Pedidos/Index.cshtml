@using System.Globalization
@model IEnumerable<ManejoPresupuestos.Models.Pedido>
@{
    ViewData["Title"] = "Pedidos";

    string StatusClass(string? s)
    {
        var v = (s ?? "").Trim().ToLowerInvariant();
        if (v.Contains("entregado")) return "st-green";
        if (v.Contains("produccion") || v.Contains("proceso")) return "st-amber";
        if (v.Contains("cancel")) return "st-red";
        return "st-gray";
    }

    string Money(decimal? n) => (n ?? 0m).ToString("C", new CultureInfo("es-MX"));
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --primary: #1D4ED8;
    }

    body{ background: var(--pg-bg); }

    .pg-wrap{ max-width: 1200px; }

    .pg-title{
        color: var(--text);
        font-weight: 800;
        letter-spacing: -.02em;
        font-size: clamp(1.85rem, 1.25rem + 1.3vw, 2.6rem);
        line-height: 1.05;
        margin: 0;
    }

    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .45rem;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .55rem 1rem;
        font-weight: 750;
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
        font-size: .92rem;
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .table-clean{ margin: 0; }

    .table-clean thead th{
        color: var(--muted);
        font-weight: 800;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        padding: .85rem 1rem;
        border-bottom: 1px solid rgba(15,23,42,.08);
        white-space: nowrap;
    }

    .table-clean tbody td{
        padding: .85rem 1rem;
        border-top: 1px solid rgba(15,23,42,.06);
        vertical-align: middle;
        font-size: .92rem;
    }

    .cell-title{
        color: var(--text);
        font-weight: 800;
        margin: 0;
        font-size: .95rem;
        line-height: 1.15;
    }

    .cell-sub{
        color: var(--muted);
        font-size: .82rem;
        margin-top: .18rem;
        max-width: 360px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .st-pill{
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .35rem .7rem;
        font-weight: 800;
        font-size: .78rem;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .st-green{ background: rgba(34,197,94,.14); color: #166534; border-color: rgba(34,197,94,.20); }
    .st-amber{ background: rgba(245,158,11,.16); color: #92400E; border-color: rgba(245,158,11,.22); }
    .st-red{ background: rgba(239,68,68,.14); color: #991B1B; border-color: rgba(239,68,68,.20); }
    .st-gray{ background: rgba(148,163,184,.20); color: #334155; border-color: rgba(148,163,184,.22); }

    .act-wrap{
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
        flex-wrap: nowrap;
        white-space: nowrap;
    }

    .act-btn{
        border-radius: 999px;
        padding: .38rem .75rem;
        font-weight: 800;
        border: 1px solid transparent;
        font-size: .85rem;
        line-height: 1.1;
    }
    .act-view{
        background: rgba(15,23,42,.05);
        color: #334155;
        border-color: rgba(15,23,42,.06);
    }
    .act-edit{
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
        box-shadow: 0 10px 16px rgba(29,78,216,.14);
    }
    .act-del{
        background: rgba(239,68,68,.08);
        color: #DC2626;
        border-color: rgba(239,68,68,.14);
    }

    .money{
        font-weight: 900;
        color: var(--text);
        white-space: nowrap;
        font-size: .92rem;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Pedidos</h1>
                <div class="pg-subtitle">Seguimiento de pedidos por cliente y estatus</div>
            </div>
            <a class="btn btn-primary btn-pill" asp-action="Crear">Crear Nuevo</a>
        </div>

        <div class="card card-soft">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-clean align-middle">
                        <thead>
                            <tr>
                                <th>CLIENTE</th>
                                <th>ESTATUS</th>
                                <th>CREACION</th>
                                <th>ENTREGA ESTIMADA</th>
                                <th class="text-end">TOTAL ESTIMADO</th>
                                <th class="text-end">ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td style="min-width: 240px;">
                                        <div class="cell-title">@p.ClienteNombre</div>
                                        <div class="cell-sub">Pedido #@p.PedidoId@(string.IsNullOrWhiteSpace(p.Notas) ? "" : $" · {p.Notas}")</div>
                                    </td>

                                    <td>
                                        <span class="st-pill @StatusClass(p.EstatusNombre)">@p.EstatusNombre</span>
                                    </td>

                                    <td style="white-space: nowrap;">@p.FechaCreacion.ToString("dd/MM/yyyy")</td>

                                    <td style="white-space: nowrap;">
                                        @(p.FechaEntregaEstimada.HasValue ? p.FechaEntregaEstimada.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>

                                    <td class="text-end money">@Money(p.TotalEstimado)</td>

                                    <td class="text-end" style="min-width: 220px;">
                                        <div class="act-wrap">
                                            <a class="btn act-btn act-view" asp-action="Detalles" asp-route-id="@p.PedidoId">Ver</a>
                                            <a class="btn act-btn act-edit" asp-action="Editar" asp-route-id="@p.PedidoId">Editar</a>
                                            <a class="btn act-btn act-del" asp-action="Borrar" asp-route-id="@p.PedidoId">Borrar</a>
                                        </div>
                                    </td>
                                </tr>
                            }

                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4" style="color: var(--muted);">
                                        No hay pedidos registrados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>