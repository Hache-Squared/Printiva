@model ManejoPresupuestos.Models.PedidoDetallesViewModel
@{
    ViewData["Title"] = "Detalles de pedido";

    string StatusClass(string? s)
    {
        var v = (s ?? "").Trim().ToLowerInvariant();
        if (v.Contains("entregado")) return "st-green";
        if (v.Contains("produccion") || v.Contains("proceso")) return "st-amber";
        if (v.Contains("cancel")) return "st-red";
        return "st-gray";
    }
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --primary: #1D4ED8;
        --danger: #DC2626;
    }

    body{ background: var(--pg-bg); }

    .pg-wrap{ max-width: 1100px; }

    .pg-title{
        color: var(--text);
        font-weight: 850;
        letter-spacing: -.02em;
        font-size: clamp(2rem, 1.4rem + 1.4vw, 2.9rem);
        line-height: 1.05;
        margin: 0;
    }

    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .6rem 1.05rem;
        font-weight: 800;
        font-size: .92rem;
        white-space: nowrap;
    }

    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .section-title{
        color: var(--text);
        font-weight: 850;
        font-size: 1.05rem;
        margin: 0 0 .9rem 0;
    }

    .kv{
        padding: .85rem 1rem;
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 14px;
        background: rgba(15,23,42,.02);
    }

    .kv-label{
        color: var(--muted);
        font-weight: 800;
        font-size: .72rem;
        letter-spacing: .14em;
        text-transform: uppercase;
        margin-bottom: .35rem;
    }

    .kv-value{
        color: var(--text);
        font-weight: 850;
        font-size: .96rem;
        margin: 0;
        word-break: break-word;
    }

    .st-pill{
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .42rem .8rem;
        font-weight: 850;
        font-size: .84rem;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .st-green{ background: rgba(34,197,94,.14); color: #166534; border-color: rgba(34,197,94,.20); }
    .st-amber{ background: rgba(245,158,11,.16); color: #92400E; border-color: rgba(245,158,11,.22); }
    .st-red{ background: rgba(239,68,68,.14); color: #991B1B; border-color: rgba(239,68,68,.20); }
    .st-gray{ background: rgba(148,163,184,.20); color: #334155; border-color: rgba(148,163,184,.22); }

    .table-clean{
        margin: 0;
    }

    .table-clean thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        padding: .95rem 1.05rem;
        border-bottom: 1px solid rgba(15,23,42,.08);
        white-space: nowrap;
    }

    .table-clean tbody td{
        padding: .95rem 1.05rem;
        border-top: 1px solid rgba(15,23,42,.06);
        vertical-align: middle;
    }

    .money{
        font-weight: 900;
        color: var(--text);
        white-space: nowrap;
    }

    .total-box{
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 16px;
        padding: .9rem 1rem;
        background: rgba(15,23,42,.02);
        min-width: 220px;
    }

    .modal-content{
        border: 0;
        border-radius: 18px;
        box-shadow: 0 18px 60px rgba(2, 6, 23, .25);
    }

    .modal-header{
        border-bottom: 1px solid rgba(15,23,42,.08);
    }

    .modal-title{
        font-weight: 850;
        color: var(--text);
    }

    .modal-body .form-control{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
    }
    .modal-body .form-control:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Pedido #@Model.Pedido.PedidoId</h1>
                <div class="pg-subtitle">@Model.Pedido.ClienteNombre · @Model.Pedido.EstatusNombre</div>
            </div>

            <div class="d-flex gap-2 flex-wrap align-items-center">
                <a class="btn btn-pill btn-soft" asp-action="Index">Volver</a>
                <a class="btn btn-primary btn-pill btn-primary-pill" asp-action="Editar" asp-route-id="@Model.Pedido.PedidoId">Editar</a>
                <a class="btn btn-pill btn-soft" href="/Produccion/Pedido/@Model.Pedido.PedidoId">Producción</a>

                @if (!Model.TieneCotizacion)
                {
                    <a class="btn btn-pill btn-soft"
                       asp-controller="Cotizaciones"
                       asp-action="Crear"
                       asp-route-pedidoId="@Model.Pedido.PedidoId">
                        Generar cotización
                    </a>
                }
                else
                {
                    <a class="btn btn-pill btn-soft"
                       asp-controller="Cotizaciones"
                       asp-action="Detalles"
                       asp-route-id="@Model.CotizacionId">
                        Ver cotización (@Model.CotizacionEstatusNombre)
                    </a>
                }

                <button type="button"
                        class="btn btn-pill btn-soft"
                        data-bs-toggle="modal"
                        data-bs-target="#pedidoAccionesModal"
                        data-pedido-id="@Model.Pedido.PedidoId">
                    Más
                </button>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card card-soft">
                    <div class="card-body p-4">
                        <div class="d-grid gap-3">
                            <div class="kv">
                                <div class="kv-label">Estatus</div>
                                <div class="kv-value">
                                    <span class="st-pill @StatusClass(Model.Pedido.EstatusNombre)">@Model.Pedido.EstatusNombre</span>
                                </div>
                            </div>

                            <div class="kv">
                                <div class="kv-label">Fecha creación</div>
                                <div class="kv-value">@Model.Pedido.FechaCreacion.ToString("dd/MM/yyyy")</div>
                            </div>

                            <div class="kv">
                                <div class="kv-label">Entrega estimada</div>
                                <div class="kv-value">@(
                                    Model.Pedido.FechaEntregaEstimada.HasValue
                                        ? Model.Pedido.FechaEntregaEstimada.Value.ToString("dd/MM/yyyy")
                                        : "-"
                                )</div>
                            </div>

                            <div class="kv">
                                <div class="kv-label">Total estimado</div>
                                <div class="kv-value money">@((Model.Pedido.TotalEstimado ?? 0).ToString("0.00"))</div>
                            </div>

                            <div class="kv">
                                <div class="kv-label">Notas</div>
                                <div class="kv-value">@(!string.IsNullOrWhiteSpace(Model.Pedido.Notas) ? Model.Pedido.Notas : "-")</div>
                            </div>

                            <div class="pt-1">
                                <a class="btn btn-pill" style="background: rgba(239,68,68,.08); color: var(--danger); border: 1px solid rgba(239,68,68,.14);"
                                   asp-action="Borrar" asp-route-id="@Model.Pedido.PedidoId">
                                    Borrar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card card-soft">
                    <div class="card-body p-4">
                        <h5 class="section-title">Items</h5>

                        <div class="table-responsive">
                            <table class="table table-clean align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th style="width: 110px;">Cantidad</th>
                                        <th style="width: 160px;" class="text-end">Precio unit.</th>
                                        <th style="width: 160px;" class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in Model.Items)
                                    {
                                        var pu = i.PrecioUnitarioEstimado ?? 0;
                                        var sub = pu * i.Cantidad;
                                        <tr>
                                            <td>
                                                <div class="fw-semibold" style="color: var(--text);">@i.ProductoNombre</div>
                                                @if (!string.IsNullOrWhiteSpace(i.Notas))
                                                {
                                                    <div class="text-muted small">@i.Notas</div>
                                                }
                                            </td>
                                            <td>@i.Cantidad</td>
                                            <td class="text-end money">@pu.ToString("0.00")</td>
                                            <td class="text-end money">@sub.ToString("0.00")</td>
                                        </tr>
                                    }
                                    @if (!Model.Items.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">Sin items.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <div class="text-end total-box">
                                <div class="kv-label mb-1">Total estimado</div>
                                <div class="money" style="font-size: 1.65rem;">@((Model.Pedido.TotalEstimado ?? 0).ToString("0.00"))</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pedidoAccionesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Acciones del pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="accionesPedidoMsg" class="mb-2"></div>

                <div class="mb-3">
                    <label class="form-label">Notas (opcional)</label>
                    <textarea id="accionesPedidoNotas" class="form-control" rows="2"></textarea>
                </div>

                <div id="accionesPedidoList" class="d-grid gap-2"></div>

                <form id="formCambiarEstatus" asp-action="CambiarEstatus" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PedidoId" id="accionesPedidoId" />
                    <input type="hidden" name="HaciaEstatusId" id="accionesHaciaEstatusId" />
                    <input type="hidden" name="Notas" id="accionesNotasHidden" />
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modalEl = document.getElementById('pedidoAccionesModal');
            const listEl = document.getElementById('accionesPedidoList');
            const msgEl = document.getElementById('accionesPedidoMsg');
            const pedidoIdInput = document.getElementById('accionesPedidoId');
            const haciaInput = document.getElementById('accionesHaciaEstatusId');
            const notasUi = document.getElementById('accionesPedidoNotas');
            const notasHidden = document.getElementById('accionesNotasHidden');
            const form = document.getElementById('formCambiarEstatus');

            function setMsg(text, type) {
                if (!text) { msgEl.innerHTML = ''; return; }
                const cls = type === 'danger' ? 'alert alert-danger' : 'alert alert-success';
                msgEl.innerHTML = `<div class="${cls} mb-0">${text}</div>`;
            }

            function clearList() {
                listEl.innerHTML = '';
            }

            async function loadAcciones(pedidoId) {
                setMsg('', '');
                clearList();
                listEl.innerHTML = `<button class="btn btn-outline-secondary" type="button" disabled>Cargando...</button>`;

                try {
                    const res = await fetch(`/Pedidos/AccionesDisponibles?pedidoId=${pedidoId}`, { headers: { 'Accept': 'application/json' } });
                    const data = await res.json();

                    clearList();

                    if (!Array.isArray(data) || data.length === 0) {
                        listEl.innerHTML = `<div class="text-muted">No hay acciones disponibles.</div>`;
                        return;
                    }

                    data.forEach(a => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = a.bloqueada ? 'btn btn-outline-secondary' : 'btn btn-outline-primary';
                        btn.disabled = !!a.bloqueada;
                        btn.textContent = a.accionTexto || 'Acción';

                        if (a.bloqueada && a.motivo) {
                            const small = document.createElement('div');
                            small.className = 'text-muted small mt-1';
                            small.textContent = a.motivo;

                            const wrap = document.createElement('div');
                            wrap.appendChild(btn);
                            wrap.appendChild(small);
                            listEl.appendChild(wrap);
                            return;
                        }

                        btn.addEventListener('click', () => {
                            const requiereConfirm = !!a.requiereConfirmacion;
                            if (requiereConfirm) {
                                const ok = confirm('¿Confirmas esta acción?');
                                if (!ok) return;
                            }

                            pedidoIdInput.value = String(pedidoId);
                            haciaInput.value = String(a.haciaEstatusId);
                            notasHidden.value = (notasUi.value || '').trim();
                            form.submit();
                        });

                        listEl.appendChild(btn);
                    });

                } catch (e) {
                    clearList();
                    setMsg('No se pudieron cargar acciones.', 'danger');
                }
            }

            modalEl.addEventListener('show.bs.modal', (ev) => {
                const btn = ev.relatedTarget;
                const pedidoId = btn?.getAttribute('data-pedido-id');
                notasUi.value = '';
                if (!pedidoId) {
                    setMsg('Pedido inválido.', 'danger');
                    clearList();
                    return;
                }
                loadAcciones(pedidoId);
            });
        })();
    </script>
}