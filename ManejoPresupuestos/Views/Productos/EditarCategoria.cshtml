@model ProductoCategoria;
@{
    ViewData["Title"] = "Editar Categoría de Producto";
}

<h1>Editar categoría de producto</h1>

<form asp-action="EditarCategoria" class="">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>

    <input type="hidden" asp-for="ProductoCategoriaId" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">
        Enviar
    </button>
    <a asp-action="Categorias" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
