@model ProductoCreacionViewModel;
@{
    ViewData["Title"] = "Editar Producto";
}

<h1>Editar producto</h1>

<form asp-action="Editar" class="">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>

    <input type="hidden" asp-for="ProductoId" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductoCategoriaId" class="form-label"></label>
        <select asp-for="ProductoCategoriaId" asp-items="@Model.Categorias" class="form-select"></select>
        <span asp-validation-for="ProductoCategoriaId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PrecioSugerido" class="form-label"></label>
        <input asp-for="PrecioSugerido" class="form-control" />
        <span asp-validation-for="PrecioSugerido" class="text-danger"></span>
    </div>


    <button class="btn btn-primary" type="submit">
        Enviar
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
