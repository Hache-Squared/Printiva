@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="mb-4">
                <i class="bi bi-printer" style="font-size: 4rem; color: #0d6efd;"></i>
            </div>
            
            <h1 class="display-5 fw-bold">Bienvenido al Sistema de Gestión Print3D</h1>
            <p class="lead text-muted mt-3">
                Tu centro de comando para la gestión de proyectos, monitoreo de impresoras, 
                control de inventario de filamentos y flujo de trabajo de producción.
            </p>

            <div class="row mt-5 g-3">
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-primary">
                        <div class="card-body">
                            <h5 class="card-title text-primary">Pedidos</h5>
                            <p class="card-text small">Gestiona los pedidos y productos.</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-success">
                        <div class="card-body">
                            <h5 class="card-title text-success">Producción</h5>
                            <p class="card-text small">Monitorea el estado de los materiales y la gestión de procesos.</p>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-warning">
                        <div class="card-body">
                            <h5 class="card-title text-warning">Inventario</h5>
                            <p class="card-text small">Control de stock de filamentos y materiales.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>