@{
    ViewData["Title"] = "No Encontrado";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --primary: #1D4ED8;
        --danger: #EF4444;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 920px; }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(1.85rem, 1.35rem + 1.15vw, 2.55rem);
        line-height: 1.08;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 90ch;
    }

    .danger-panel{
        border: 1px solid rgba(239,68,68,.22);
        background: rgba(239,68,68,.06);
        border-radius: 16px;
        padding: 1rem 1rem;
        color: var(--text);
    }

    .btn-pill{
        border-radius: 999px;
        padding: .62rem 1.06rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="mb-4">
            <h1 class="pg-title">No encontrado</h1>
            <div class="pg-subtitle">El elemento solicitado no ha sido encontrado.</div>
        </div>

        <div class="card card-soft">
            <div class="card-body p-4">
                <div class="danger-panel mb-3">
                    Elemento solicitado no ha sido encontrado
                </div>

                <div class="d-flex gap-2">
                    <a class="btn btn-primary btn-pill btn-primary-pill" asp-action="Index">Volver</a>
                    <a class="btn btn-pill btn-soft" href="javascript:history.back()">Regresar</a>
                </div>
            </div>
        </div>

    </div>
</div>