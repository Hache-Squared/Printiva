            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Print3D</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Can("Reportes"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reportes" asp-action="Index">Reportes</a>
                            </li>
                        }

                        @if (Can("Pedidos"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pedidos" asp-action="Kanban">Kanban Pedidos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                            </li>
                        }

                        @if (Can("Cotizaciones"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cotizaciones" asp-action="Index">Cotizaciones</a>
                            </li>
                        }

                        @if (Can("Productos"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Productos" asp-action="Index">Productos</a>
                            </li>
                        }

                        @if (Can("Recetas"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Recetas" asp-action="Index">Recetas</a>
                            </li>
                        }

                        @if (Can("Inventarios"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Inventarios" asp-action="Index">Inventarios</a>
                            </li>
                        }

                        @if (Can("Impresoras"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Impresoras" asp-action="Index">Impresoras</a>
                            </li>
                        }

                        @if (Can("Tarifas"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Tarifas" asp-action="Index">Tarifas</a>
                            </li>
                        }

                        @if (Can("Compras"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Compras" asp-action="Index">Compras</a>
                            </li>
                        }

                        @if (Can("Clientes"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Clientes" asp-action="Index">Clientes</a>
                            </li>
                        }

                        @if (Can("Usuarios"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            </li>
                        }

                    </ul>
                    <partial name="_LinksLogin" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        @* <div class="container">
            &copy; 2025 - Printiva - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div> *@
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
