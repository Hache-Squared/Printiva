@using System.Security.Claims
@inject ManejoPresupuestos.Servicios.IServicioPermisos PermSvc

@{
    var esAdmin = false;
    var permisos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    if (User?.Identity?.IsAuthenticated == true)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier);
        if (idClaim != null && int.TryParse(idClaim.Value, out var uid))
        {
            esAdmin = await PermSvc.EsAdminAsync(uid);
            if (!esAdmin)
            {
                permisos = await PermSvc.ObtenerPermisosAsync(uid);
            }
        }
    }

    bool Can(string key) => esAdmin || permisos.Contains(key);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ManejoPresupuestos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ManejoPresupuestos.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true"/>
    <link rel="stylesheet" href="ManejoPresupuestos.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/fullcalendar/main.min.css" />

    <style>
        :root{
            --app-bg: #F6F7FB;
            --nav-grad-a: #0F66E9;
            --nav-grad-b: #1D4ED8;
            --nav-grad-c: #7C3AED;
            --nav-pill: rgba(255,255,255,.16);
            --nav-pill-hover: rgba(255,255,255,.22);
            --nav-text: rgba(255,255,255,.90);
        }

        html, body{ overflow-x: hidden; }

        body{ background: var(--app-bg); }

        .app-navbar{
            background: linear-gradient(90deg, var(--nav-grad-a) 0%, var(--nav-grad-b) 45%, var(--nav-grad-c) 100%);
            border: 0 !important;
            border-radius: 18px;
            width: calc(100% - 24px);
            margin: 12px auto 18px;
            box-shadow: 0 10px 28px rgba(2, 6, 23, .18);
        }

        .app-navbar .navbar-brand{
            font-weight: 800;
            letter-spacing: .2px;
            color: #fff !important;
        }

        .app-brand-icon{
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.18);
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.15);
        }

        .app-navbar .navbar-toggler{
            border-color: rgba(255,255,255,.35);
        }
        .app-navbar .navbar-toggler:focus{
            box-shadow: 0 0 0 .2rem rgba(255,255,255,.18);
        }

        .app-nav-scroller{
            min-width: 0;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;

            /* Firefox */
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.18) transparent;
        }

        .app-nav-scroller::-webkit-scrollbar{
            height: 6px;                 /* área total */
        }
        .app-nav-scroller::-webkit-scrollbar-track{
            background: transparent;     /* sin “barra gris” */
        }
        .app-nav-scroller::-webkit-scrollbar-thumb{
            background: rgba(255,255,255,.12);   /* mega tenue */
            border-radius: 999px;
            border: 2px solid transparent;       /* lo hace ver más delgado */
            background-clip: padding-box;        /* respeta el borde transparente */
        }
        .app-nav-scroller:hover::-webkit-scrollbar-thumb{
            background: rgba(255,255,255,.28);   /* solo al hover se nota */
        }

        /* Links tipo pill */
        .app-navbar .navbar-nav .nav-link{
            color: var(--nav-text) !important;
            font-weight: 650;
            padding: .52rem .85rem;
            border-radius: 999px;
            white-space: nowrap;
            transition: transform .08s ease, background-color .15s ease, color .15s ease;
        }
        .app-navbar .navbar-nav .nav-link:hover{
            background: var(--nav-pill-hover);
            color: #fff !important;
            transform: translateY(-1px);
        }

        .app-navbar .navbar-nav .nav-link.active,
        .app-navbar .navbar-nav .nav-link[aria-current="page"]{
            background: rgba(255,255,255,.96);
            color: #0B5ED7 !important;
            box-shadow: 0 10px 18px rgba(2, 6, 23, .12);
        }

        .app-navbar .navbar-text,
        .app-navbar .nav-link,
        .app-navbar a{
            color: var(--nav-text);
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark app-navbar">
            <div class="container-fluid px-3 py-2">

                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-icon">
                        <i class="bi bi-printer-fill text-white fs-5"></i>
                    </span>
                    <span>Print3D</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center" style="min-width:0;">
                    <!-- Scroller del menú (aquí se queda el scroll X) -->
                    <div class="app-nav-scroller flex-grow-1 me-sm-3">
                        <ul class="navbar-nav flex-column flex-sm-row flex-sm-nowrap gap-1 gap-sm-2 py-1">
                            @if (Can("Reportes"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reportes" asp-action="Index">Reportes</a>
                                </li>
                            }

                            @if (Can("Pedidos"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Pedidos" asp-action="Kanban">Kanban</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                                </li>
                            }

                            @if (Can("Cotizaciones"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cotizaciones" asp-action="Index">Cotizaciones</a>
                                </li>
                            }

                            @if (Can("Productos"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Productos" asp-action="Index">Productos</a>
                                </li>
                            }

                            @if (Can("Recetas"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Recetas" asp-action="Index">Recetas</a>
                                </li>
                            }

                            @if (Can("Inventarios"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Inventarios" asp-action="Index">Inventarios</a>
                                </li>
                            }

                            @if (Can("Impresoras"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Impresoras" asp-action="Index">Impresoras</a>
                                </li>
                            }

                            @if (Can("Tarifas"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tarifas" asp-action="Index">Tarifas</a>
                                </li>
                            }

                            @if (Can("Compras"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Compras" asp-action="Index">Compras</a>
                                </li>
                            }

                            @if (Can("Clientes"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                </li>
                            }

                            @if (Can("Usuarios"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="d-flex align-items-center mt-2 mt-sm-0 flex-shrink-0">
                        <partial name="_LinksLogin" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted"></footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>