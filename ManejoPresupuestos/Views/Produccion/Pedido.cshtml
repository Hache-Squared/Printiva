@model ManejoPresupuestos.Models.ProduccionPedidoViewModel
@{
    ViewData["Title"] = "Producción del Pedido";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
        --success: #16A34A;
        --danger: #EF4444;
    }

    body{ background: var(--pg-bg); }

    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
        font-size: clamp(1.9rem, 1.35rem + 1.25vw, 2.55rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
        max-width: 90ch;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .56rem 1.02rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-pill.btn-sm{
        padding: .40rem .78rem;
        font-size: .84rem;
    }

    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }

    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .kpi-label{ color: var(--muted); font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; font-weight: 850; }
    .kpi-value{ color: var(--text); font-weight: 850; }

    .table-clean{ margin: 0; }
    .table-clean thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        padding: .70rem .90rem;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
        vertical-align: middle;
    }
    .table-clean tbody td{
        padding: .58rem .90rem;
        border-top: 1px solid rgba(15,23,42,.06);
        vertical-align: middle;
        font-size: .95rem;
    }

    .control-soft{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
    }
    .control-soft:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }
    .control-soft.control-sm{
        padding-top: .46rem;
        padding-bottom: .46rem;
    }

    .badge-soft{
        border-radius: 999px;
        padding: .34rem .62rem;
        font-weight: 900;
        font-size: .78rem;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        color: var(--text);
        white-space: nowrap;
    }

    .hint{
        color: var(--muted);
        font-size: .9rem;
    }

    .modal-modern .modal-content{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 18px 50px rgba(2,6,23,.16);
    }
    .modal-modern .modal-header{
        border-bottom: 1px solid var(--border2);
        padding: 1.05rem 1.15rem;
    }
    .modal-modern .modal-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
    }
    .modal-modern .modal-body{
        padding: 1.15rem 1.15rem 1.05rem;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Producción — Pedido #@Model.Pedido.PedidoId</h1>
                <div class="pg-subtitle">@Model.Pedido.ClienteNombre · @Model.Pedido.EstatusNombre</div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-pill btn-soft" href="/Pedidos/Detalles/@Model.Pedido.PedidoId">Volver al pedido</a>
                <a class="btn btn-pill btn-soft" href="/Pedidos/Kanban">Kanban</a>
            </div>
        </div>

        <div class="card card-soft mb-3">
            <div class="card-body py-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="kpi-label">Cliente</div>
                        <div class="kpi-value">@Model.Pedido.ClienteNombre</div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-label">Entrega</div>
                        <div class="kpi-value">@((Model.Pedido.FechaEntregaEstimada?.ToString("dd/MM/yyyy")) ?? "-")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="kpi-label">Total estimado</div>
                        <div class="kpi-value">@((Model.Pedido.TotalEstimado ?? 0).ToString("N2"))</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Anti-forgery para AJAX (UNO SOLO) -->
        <form id="afForm" method="post">
            @Html.AntiForgeryToken()
        </form>

        <div class="card card-soft">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
                    <div>
                        <div class="fw-semibold" style="color: var(--text); font-weight: 900;">Items de producción</div>
                        <div class="hint">El avance del pedido se desbloquea cuando todos los items avanzan (motor).</div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-clean align-middle">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th style="width:120px;">Cantidad</th>
                                <th style="width:200px;">Estatus</th>

                                <th style="width:220px;">Impresora</th>
                                <th style="width:150px;">Peso real</th>
                                <th>Notas operativas</th>

                                <th style="width:140px;"></th>
                                <th style="width:140px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var it in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@it.ProductoNombre</td>
                                    <td>@it.Cantidad</td>

                                    <td>
                                        <span class="badge badge-soft @it.BadgeClass text-white">@it.EstatusNombre</span>
                                    </td>

                                    <td>
                                        <select class="form-select form-select-sm control-soft control-sm kbImpresora" data-id="@it.ProduccionItemId">
                                            <option value="">(sin asignar)</option>
                                            @foreach (var imp in Model.Impresoras)
                                            {
                                                <option value="@imp.Value" selected="@(it.ImpresoraId?.ToString() == imp.Value)">
                                                    @imp.Text
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <input type="number"
                                               step="0.01"
                                               class="form-control form-control-sm control-soft control-sm kbPesoReal"
                                               data-id="@it.ProduccionItemId"
                                               value="@(it.PesoRealGr?.ToString() ?? "")"
                                               placeholder="0.00" />
                                    </td>

                                    <td>
                                        <input class="form-control form-control-sm control-soft control-sm kbNotasOper"
                                               data-id="@it.ProduccionItemId"
                                               value="@(it.NotasOperativas ?? "")"
                                               placeholder="Notas operativas..." />
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-pill btn-soft btn-sm kbGuardar"
                                                data-id="@it.ProduccionItemId">
                                            Guardar
                                        </button>
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-primary btn-pill btn-primary-pill btn-sm btnProdAcciones"
                                                data-id="@it.ProduccionItemId"
                                                data-producto="@it.ProductoNombre"
                                                data-inv="@(it.InventarioAplicado ? "1" : "0")">
                                            Más
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">Sin items de producción</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- Modal Acciones -->
<div class="modal fade modal-modern" id="prodModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="prodModalTitle">Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: var(--text);">Receta para este item</label>
                    <div class="d-flex gap-2 flex-wrap">
                        <select id="prodRecetaSelect" class="form-select control-soft"></select>
                        <button id="btnAsignarReceta" type="button" class="btn btn-pill btn-soft">Asignar</button>
                    </div>
                    <div id="prodRecetaInfo" class="small text-muted mt-1"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: var(--text);">Notas</label>
                    <textarea id="prodNotas" class="form-control control-soft" rows="3" placeholder="Qué cambió / por qué..."></textarea>
                </div>

                <hr />

                <div class="fw-semibold mb-2" style="color: var(--text); font-weight: 900;">Acciones disponibles</div>
                <div id="prodAcciones" class="d-flex flex-wrap gap-2"></div>
                <div id="prodAccionesEmpty" class="text-muted d-none">No hay acciones disponibles para este item.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const tokenEl = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
    const token = tokenEl ? tokenEl.value : '';

    // Modal
    const modalEl = document.getElementById('prodModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    let currentProduccionItemId = 0;
    let currentInvAplicado = false;

    function parseBool(v){
        return v === true || v === 1 || v === '1' || v === 'true' || v === 'True';
    }

    function okFromResponse(r){
        // soporta {ok:true} o {result:'success'}
        return (r && (r.ok === true || r.result === 'success'));
    }

    // ---------- Recetas ----------
    async function loadRecetasItem(produccionItemId) {
        const sel = document.getElementById('prodRecetaSelect');
        const info = document.getElementById('prodRecetaInfo');

        sel.innerHTML = '';
        info.textContent = '';

        // Si ya aplicó inventario: UI bloquea (SP también lo bloquea)
        sel.disabled = !!currentInvAplicado;
        document.getElementById('btnAsignarReceta').disabled = !!currentInvAplicado;

        try {
            const res = await fetch(`/Produccion/RecetasDisponiblesPorItem?produccionItemId=${produccionItemId}`, {
                headers: { 'Accept': 'application/json' }
            });

            if(!res.ok){
                throw new Error('HTTP ' + res.status);
            }

            const recetas = await res.json();

            if (!recetas || recetas.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = '(sin recetas)';
                sel.appendChild(opt);

                info.textContent = currentInvAplicado
                    ? 'Receta bloqueada: inventario ya aplicado.'
                    : 'No hay recetas para este producto.';

                return;
            }

            let selected = null;

            for (const r of recetas) {
                const recetaId = Number(r.recetaId ?? r.RecetaId ?? 0);
                const nombre = r.nombre ?? r.Nombre ?? '(sin nombre)';
                const isSelected = parseBool(r.isSelected ?? r.IsSelected ?? false);

                const opt = document.createElement('option');
                opt.value = String(recetaId);
                opt.textContent = isSelected ? `✅ ${nombre}` : nombre;
                opt.selected = isSelected;

                sel.appendChild(opt);

                if (isSelected) selected = r;
            }

            if (currentInvAplicado) {
                const nombre = selected ? (selected.nombre ?? selected.Nombre ?? '') : '';
                const t = selected ? (selected.tiempoImpresion ?? selected.TiempoImpresion ?? '') : '';
                info.textContent = nombre
                    ? `Receta bloqueada (inventario aplicado). Seleccionada: ${nombre}${t ? ` · Tiempo: ${t}` : ''}`
                    : 'Receta bloqueada (inventario aplicado).';
                return;
            }

            if (selected) {
                const nombre = selected.nombre ?? selected.Nombre ?? '';
                const t = selected.tiempoImpresion ?? selected.TiempoImpresion ?? '';
                info.textContent = `Seleccionada: ${nombre}${t ? ` · Tiempo: ${t}` : ''}`;
            } else {
                info.textContent = 'Selecciona una receta (necesaria para Post-procesado).';
            }
        } catch (err) {
            sel.innerHTML = '';
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '(error cargando recetas)';
            sel.appendChild(opt);

            info.textContent = 'Error cargando recetas.';
            console.error(err);
        }
    }

    document.getElementById('btnAsignarReceta').addEventListener('click', async () => {
        if (currentInvAplicado) {
            alert('No puedes cambiar receta: inventario ya aplicado (Post-procesado).');
            return;
        }

        const sel = document.getElementById('prodRecetaSelect');
        const recetaId = Number(sel.value || 0);

        if (!currentProduccionItemId) {
            alert('No hay item seleccionado.');
            return;
        }
        if (!recetaId) {
            alert('Selecciona una receta.');
            return;
        }

        const payload = new URLSearchParams();
        payload.set('ProduccionItemId', String(currentProduccionItemId));
        payload.set('RecetaId', String(recetaId));

        const res = await fetch('/Produccion/AsignarRecetaItemAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: payload.toString()
        });

        const r = await res.json();
        if (!okFromResponse(r)) {
            alert(r.message || 'No se pudo asignar la receta.');
            return;
        }

        // refresca receta + acciones (para desbloquear Post)
        await loadRecetasItem(currentProduccionItemId);
        await loadAcciones(currentProduccionItemId);
    });

    // ---------- Acciones ----------
    async function loadAcciones(produccionItemId) {
        const wrap = document.getElementById('prodAcciones');
        const empty = document.getElementById('prodAccionesEmpty');

        wrap.innerHTML = '';
        empty.classList.add('d-none');

        try {
            const res = await fetch(`/Produccion/AccionesDisponibles?produccionItemId=${produccionItemId}`, {
                headers: { 'Accept': 'application/json' }
            });

            if(!res.ok){
                throw new Error('HTTP ' + res.status);
            }

            const acciones = await res.json();

            if (!acciones || acciones.length === 0) {
                empty.classList.remove('d-none');
                return;
            }

            for (const a of acciones) {
                const texto = a.accionTexto ?? a.AccionTexto ?? 'Acción';
                const hacia = Number(a.haciaEstatusId ?? a.HaciaEstatusId ?? 0);
                const reqConf = parseBool(a.requiereConfirmacion ?? a.RequiereConfirmacion ?? false);

                const bloqueada = parseBool(a.bloqueada ?? a.Bloqueada ?? false);
                const motivo = a.motivo ?? a.Motivo ?? '';

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = texto;

                btn.dataset.hacia = String(hacia);

                if (bloqueada) {
                    btn.className = 'btn btn-outline-secondary btn-pill';
                    btn.disabled = true;
                    btn.title = motivo || 'Acción bloqueada';

                    const box = document.createElement('div');
                    box.className = 'd-flex flex-column gap-1';
                    box.appendChild(btn);

                    if (motivo) {
                        const small = document.createElement('div');
                        small.className = 'small text-muted';
                        small.textContent = motivo;
                        box.appendChild(small);
                    }

                    wrap.appendChild(box);
                    continue;
                }

                btn.className = 'btn btn-primary btn-pill btn-primary-pill';
                btn.addEventListener('click', async () => {
                    const haciaId = Number(btn.dataset.hacia || 0);

                    if (!haciaId) {
                        alert('Acción inválida: no llegó el HaciaEstatusId. Recarga la página.');
                        return;
                    }

                    if (reqConf) {
                        const ok = confirm(`¿Confirmas la acción?\n\n${texto}`);
                        if (!ok) return;
                    }

                    const notas = document.getElementById('prodNotas').value || '';
                    await ejecutarAccion(produccionItemId, haciaId, notas);
                });

                wrap.appendChild(btn);
            }
        } catch (err) {
            empty.classList.remove('d-none');
            empty.textContent = 'Error cargando acciones.';
            console.error(err);
        }
    }

    async function ejecutarAccion(produccionItemId, haciaEstatusId, notas) {
        const payload = new URLSearchParams();
        payload.set('ProduccionItemId', String(produccionItemId));
        payload.set('HaciaEstatusId', String(haciaEstatusId));
        payload.set('Notas', notas);

        const res = await fetch('/Produccion/CambiarEstatusItemAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: payload.toString()
        });

        const r = await res.json();
        if (!okFromResponse(r)) {
            alert(r.message || 'No se pudo ejecutar la acción.');
            return;
        }

        modal.hide();
        window.location.reload();
    }

    // Abrir modal (carga recetas + acciones)
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.btnProdAcciones');
        if (!btn) return;

        const itemId = Number(btn.getAttribute('data-id') || 0);
        const producto = btn.getAttribute('data-producto') || 'Item';

        currentProduccionItemId = itemId;

        // UI: si traes data-inv="1" lo bloquea en el modal
        currentInvAplicado = parseBool(btn.getAttribute('data-inv'));

        document.getElementById('prodModalTitle').textContent = producto;
        document.getElementById('prodNotas').value = '';

        await loadRecetasItem(itemId);
        await loadAcciones(itemId);

        modal.show();
    });

    // ---------- Guardado datos extra ----------
    function getVal(cls, id) {
        const el = document.querySelector(`.${cls}[data-id="${id}"]`);
        return el ? el.value : '';
    }

    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.kbGuardar');
        if (!btn) return;

        const id = Number(btn.getAttribute('data-id'));

        const payload = new URLSearchParams();
        payload.set('ProduccionItemId', String(id));
        payload.set('ImpresoraId', getVal('kbImpresora', id) || '');
        payload.set('PesoRealGr', getVal('kbPesoReal', id) || '');
        payload.set('NotasOperativas', getVal('kbNotasOper', id) || '');

        const res = await fetch('/Produccion/ActualizarItemDatosAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: payload.toString()
        });

        const r = await res.json();
        if (!okFromResponse(r)) {
            alert(r.message || 'No se pudo guardar.');
            return;
        }

        alert('Guardado');
    });

})();
</script>
}