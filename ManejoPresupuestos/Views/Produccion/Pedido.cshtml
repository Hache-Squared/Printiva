@model ManejoPresupuestos.Models.ProduccionPedidoViewModel
@{
    ViewData["Title"] = "Producción del Pedido";
}

<div class="container py-4">
    <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
        <div>
            <h1 class="mb-1">Producción — Pedido #@Model.Pedido.PedidoId</h1>
            <div class="text-muted">@Model.Pedido.ClienteNombre · @Model.Pedido.EstatusNombre</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/Pedidos/Detalles/@Model.Pedido.PedidoId">Volver al pedido</a>
            <a class="btn btn-outline-secondary" href="/Pedidos/Kanban">Kanban</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-6">
                    <div class="small text-muted">Cliente</div>
                    <div class="fw-semibold">@Model.Pedido.ClienteNombre</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted">Entrega</div>
                    <div class="fw-semibold">@((Model.Pedido.FechaEntregaEstimada?.ToString("dd/MM/yyyy")) ?? "-")</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted">Total estimado</div>
                    <div class="fw-semibold">@((Model.Pedido.TotalEstimado ?? 0).ToString("N2"))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Anti-forgery para AJAX (UNO SOLO) -->
    <form id="afForm" method="post">
        @Html.AntiForgeryToken()
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0">Items de producción</h5>
                <div class="text-muted small">El avance del pedido se desbloquea cuando todos los items avanzan (motor).</div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th style="width:120px;">Cantidad</th>
                            <th style="width:200px;">Estatus</th>

                            <th style="width:220px;">Impresora</th>
                            <th style="width:150px;">Peso real (gr)</th>
                            <th>Notas operativas</th>

                            <th style="width:120px;"></th>
                            <th style="width:120px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@it.ProductoNombre</td>
                                <td>@it.Cantidad</td>

                                <td>
                                    <span class="badge @it.BadgeClass">@it.EstatusNombre</span>
                                </td>

                                <td>
                                    <select class="form-select form-select-sm kbImpresora" data-id="@it.ProduccionItemId">
                                        <option value="">(sin asignar)</option>
                                        @foreach (var imp in Model.Impresoras)
                                        {
                                            <option value="@imp.Value" selected="@(it.ImpresoraId?.ToString() == imp.Value)">
                                                @imp.Text
                                            </option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input type="number"
                                           step="0.01"
                                           class="form-control form-control-sm kbPesoReal"
                                           data-id="@it.ProduccionItemId"
                                           value="@(it.PesoRealGr?.ToString() ?? "")"
                                           placeholder="0.00" />
                                </td>

                                <td>
                                    <input class="form-control form-control-sm kbNotasOper"
                                           data-id="@it.ProduccionItemId"
                                           value="@(it.NotasOperativas ?? "")"
                                           placeholder="Notas operativas..." />
                                </td>

                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm kbGuardar"
                                            data-id="@it.ProduccionItemId">
                                        Guardar
                                    </button>
                                </td>

                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary btnProdAcciones"
                                            data-id="@it.ProduccionItemId"
                                            data-producto="@it.ProductoNombre">
                                        Más
                                    </button>
                                </td>
                            </tr>
                        }

                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Sin items de producción</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Modal Acciones -->
<div class="modal fade" id="prodModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="prodModalTitle">Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Receta para este item</label>
                    <div class="d-flex gap-2">
                        <select id="prodRecetaSelect" class="form-select"></select>
                        <button id="btnAsignarReceta" type="button" class="btn btn-outline-primary">Asignar</button>
                    </div>
                    <div id="prodRecetaInfo" class="small text-muted mt-1"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Notas</label>
                    <textarea id="prodNotas" class="form-control" rows="3" placeholder="Qué cambió / por qué..."></textarea>
                </div>

                <hr />

                <div class="fw-semibold mb-2">Acciones disponibles</div>
                <div id="prodAcciones" class="d-flex flex-wrap gap-2"></div>
                <div id="prodAccionesEmpty" class="text-muted d-none">No hay acciones disponibles para este item.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const tokenEl = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
    const token = tokenEl ? tokenEl.value : '';

    // Modal
    const modalEl = document.getElementById('prodModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    let currentProduccionItemId = 0;

    // ---------- Recetas ----------
    async function loadRecetasItem(produccionItemId) {
        const sel = document.getElementById('prodRecetaSelect');
        const info = document.getElementById('prodRecetaInfo');

        sel.innerHTML = '';
        info.textContent = '';

        try {
            const res = await fetch(`/Produccion/RecetasDisponiblesPorItem?produccionItemId=${produccionItemId}`, {
                headers: { 'Accept': 'application/json' }
            });

            const recetas = await res.json();

            if (!recetas || recetas.length === 0) {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = '(sin recetas)';
                sel.appendChild(opt);
                info.textContent = 'No hay recetas para este producto.';
                return;
            }

            let selected = null;

            for (const r of recetas) {
                const recetaId = r.recetaId ?? r.RecetaId ?? 0;
                const nombre = r.nombre ?? r.Nombre ?? '(sin nombre)';
                const isSelected = r.isSelected ?? r.IsSelected ?? false;

                const opt = document.createElement('option');
                opt.value = String(recetaId);
                opt.textContent = isSelected ? `✅ ${nombre}` : nombre;
                opt.selected = !!isSelected;

                sel.appendChild(opt);

                if (isSelected) selected = r;
            }

            if (selected) {
                const nombre = selected.nombre ?? selected.Nombre ?? '';
                const t = selected.tiempoImpresion ?? selected.TiempoImpresion ?? '';
                info.textContent = `Seleccionada: ${nombre}${t ? ` · Tiempo: ${t}` : ''}`;
            } else {
                info.textContent = 'Selecciona una receta (necesaria para Post-procesado).';
            }
        } catch (err) {
            sel.innerHTML = '';
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '(error cargando recetas)';
            sel.appendChild(opt);
            info.textContent = 'Error cargando recetas.';
            console.error(err);
        }
    }

    document.getElementById('btnAsignarReceta').addEventListener('click', async () => {
        const sel = document.getElementById('prodRecetaSelect');
        const recetaId = Number(sel.value || 0);

        if (!currentProduccionItemId) {
            alert('No hay item seleccionado.');
            return;
        }
        if (!recetaId) {
            alert('Selecciona una receta.');
            return;
        }

        const payload = new URLSearchParams();
        payload.set('ProduccionItemId', String(currentProduccionItemId));
        payload.set('RecetaId', String(recetaId));

        const res = await fetch('/Produccion/AsignarRecetaItemAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: payload.toString()
        });

        const r = await res.json();
        if (!r.ok) {
            alert(r.message || 'No se pudo asignar la receta.');
            return;
        }

        // refresca receta + acciones (para desbloquear Post)
        await loadRecetasItem(currentProduccionItemId);
        await loadAcciones(currentProduccionItemId);
    });

    // ---------- Acciones ----------
    async function loadAcciones(produccionItemId) {
        const wrap = document.getElementById('prodAcciones');
        const empty = document.getElementById('prodAccionesEmpty');

        wrap.innerHTML = '';
        empty.classList.add('d-none');

        try {
            const res = await fetch(`/Produccion/AccionesDisponibles?produccionItemId=${produccionItemId}`, {
                headers: { 'Accept': 'application/json' }
            });

            const acciones = await res.json();

            if (!acciones || acciones.length === 0) {
                empty.classList.remove('d-none');
                return;
            }

            for (const a of acciones) {
                const texto = a.accionTexto ?? a.AccionTexto ?? 'Acción';
                const hacia = a.haciaEstatusId ?? a.HaciaEstatusId ?? 0;
                const reqConf = a.requiereConfirmacion ?? a.RequiereConfirmacion ?? false;

                const bloqueada = a.bloqueada ?? a.Bloqueada ?? false;
                const motivo = a.motivo ?? a.Motivo ?? '';

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = texto;

                if (bloqueada) {
                    btn.className = 'btn btn-outline-secondary';
                    btn.disabled = true;
                    btn.title = motivo || 'Acción bloqueada';

                    const box = document.createElement('div');
                    box.className = 'd-flex flex-column gap-1';
                    box.appendChild(btn);

                    if (motivo) {
                        const small = document.createElement('div');
                        small.className = 'small text-muted';
                        small.textContent = motivo;
                        box.appendChild(small);
                    }

                    wrap.appendChild(box);
                    continue;
                }

                btn.className = 'btn btn-primary';
                btn.addEventListener('click', async () => {
                    if (reqConf) {
                        const ok = confirm(`¿Confirmas la acción?\n\n${texto}`);
                        if (!ok) return;
                    }

                    const notas = document.getElementById('prodNotas').value || '';
                    await ejecutarAccion(produccionItemId, hacia, notas);
                });

                wrap.appendChild(btn);
            }
        } catch (err) {
            empty.classList.remove('d-none');
            empty.textContent = 'Error cargando acciones.';
            console.error(err);
        }
    }

    async function ejecutarAccion(produccionItemId, haciaEstatusId, notas) {
        const payload = new URLSearchParams();
        payload.set('ProduccionItemId', String(produccionItemId));
        payload.set('HaciaEstatusId', String(haciaEstatusId));
        payload.set('Notas', notas);

        const res = await fetch('/Produccion/CambiarEstatusItemAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: payload.toString()
        });

        const r = await res.json();
        if (!r.ok) {
            alert(r.message || 'No se pudo ejecutar la acción.');
            return;
        }

        modal.hide();
        window.location.reload();
    }

    // Abrir modal (carga recetas + acciones)
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.btnProdAcciones');
        if (!btn) return;

        const itemId = Number(btn.getAttribute('data-id') || 0);
        const producto = btn.getAttribute('data-producto') || 'Item';

        currentProduccionItemId = itemId;

        document.getElementById('prodModalTitle').textContent = producto;
        document.getElementById('prodNotas').value = '';

        await loadRecetasItem(itemId);
        await loadAcciones(itemId);

        modal.show();
    });

    // ---------- Guardado datos extra ----------
    function getVal(cls, id) {
        const el = document.querySelector(`.${cls}[data-id="${id}"]`);
        return el ? el.value : '';
    }

    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.kbGuardar');
        if (!btn) return;

        const id = Number(btn.getAttribute('data-id'));

        const payload = new URLSearchParams();
        payload.set('ProduccionItemId', String(id));
        payload.set('ImpresoraId', getVal('kbImpresora', id) || '');
        payload.set('PesoRealGr', getVal('kbPesoReal', id) || '');
        payload.set('NotasOperativas', getVal('kbNotasOper', id) || '');

        const res = await fetch('/Produccion/ActualizarItemDatosAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'RequestVerificationToken': token
            },
            body: payload.toString()
        });

        const r = await res.json();
        if (!r.ok) {
            alert(r.message || 'No se pudo guardar.');
            return;
        }

        alert('Guardado');
    });

})();
</script>
}
