@model VentaCreacionViewModel
@{
    ViewData["Title"] = "Editar Venta";
}

<h1>Editar venta</h1>
<h5>Modifica los datos de la venta y sus partidas.</h5>

<form asp-action="Editar">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="VentaId" />

    <div class="mb-4">
        <label class="form-label fw-bold">Cliente</label>
        <div class="input-group">
            <select asp-for="ClienteId" asp-items="@Model.Clientes" class="form-select"></select>
            <button type="button" class="btn btn-outline-primary" title="Crear nuevo cliente"
                    data-bs-toggle="modal" data-bs-target="#modalCrearCliente">
                <i class="bi bi-plus-lg"></i>
            </button>
        </div>
        <span asp-validation-for="ClienteId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"
                  placeholder="Ej: Venta de 15 figuras personalizadas para evento corporativo"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaCreacion" class="form-label"></label>
        <input asp-for="FechaCreacion" class="form-control" type="date" />
        <span asp-validation-for="FechaCreacion" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Partidas de venta</h5>
            <button type="button" class="btn btn-success" title="Agregar partida"
                    data-bs-toggle="modal" data-bs-target="#modalAgregarPartida">
                <i class="bi bi-plus-lg"></i> Agregar partida
            </button>
        </div>

        @if (Model.VentaRecetas == null || !Model.VentaRecetas.Any())
        {
            <div class="alert alert-light border">
                <i class="bi bi-info-circle"></i>
                No hay partidas agregadas aún. Usa el botón para agregar.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Receta</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Costo Unitario</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var partida in Model.VentaRecetas)
                        {
                            @if (partida != null)
                            {
                                <tr data-venta-receta-id="@partida.VentaRecetaId">
                                    <td>@partida.RecetaNombre</td>
                                    <td class="text-center">@partida.Cantidad</td>
                                    <td class="text-end">@partida.CostoUnitario.ToString("C")</td>
                                    <td class="text-end fw-bold">@partida.Subtotal.ToString("C")</td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm btnEliminarPartida"
                                                data-venta-receta-id="@partida.VentaRecetaId"
                                                title="Quitar partida">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th class="text-end text-success fs-5">@Model.CostoTotal.ToString("C")</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            Enviar
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </div>
</form>

<div class="modal fade" id="modalCrearCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Nuevo Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <partial name="_CrearClientePartial" model="new Cliente()" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAgregarPartida" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Partida (Receta)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @{
                    var vmPartida = new VentaRecetaCreacionViewModel
                    {
                        VentaId = Model.VentaId,
                        Recetas = Model.Recetas ?? Enumerable.Empty<SelectListItem>()
                    };
                }
                <partial name="_CrearVentaRecetaPartial" model="vmPartida" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('.btnEliminarPartida');
            if (!btn) return;

            const ventaRecetaId = btn.dataset.ventaRecetaId;

            if (!confirm('¿Estás seguro de eliminar esta partida?')) {
                return;
            }

            try {
                const response = await fetch('@Url.Action("BorrarVentaReceta", "Ventas")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ ventaRecetaId: parseInt(ventaRecetaId) })
                });

                const result = await response.json();

                if (result.success) {
                    alert('Partida eliminada correctamente');
                    location.reload();
                } else {
                    alert('Error: ' + (result.message || 'No se pudo eliminar'));
                }
            } catch (err) {
                console.error(err);
                alert('Error de conexión');
            }
        });

        document.getElementById('modalCrearCliente').addEventListener('show.bs.modal', function () {
            const form = document.getElementById('formCrearCliente');

            if (form && !form.dataset.listenerAdded) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const formData = new FormData(this);

                    try {
                        const response = await fetch('@Url.Action("CrearCliente", "Ventas")', {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.json();

                        if (result.success) {
                            const modal = bootstrap.Modal.getInstance(document.getElementById('modalCrearCliente'));

                            if (modal) {
                                modal.hide();
                            }

                            alert('¡Cliente creado correctamente!');

                            location.reload();
                        } else {
                            alert('Error: ' + (result.message || 'Datos inválidos'));
                        }
                    } catch (err) {
                        console.error(err);
                        alert('Error de conexión');
                    }
                });

                form.dataset.listenerAdded = 'true';
            }
        });

        document.getElementById('modalCrearCliente').addEventListener('hidden.bs.modal', function () {
            document.getElementById('formCrearCliente')?.reset();
        });

        document.getElementById('modalAgregarPartida').addEventListener('hidden.bs.modal', function () {
            document.getElementById('formCrearVentaReceta')?.reset();
        });

        document.getElementById('modalAgregarPartida')?.addEventListener('show.bs.modal', function () {
            const form = document.getElementById('formCrearVentaReceta');
            if (form && !form.dataset.loaded) {
                form.addEventListener('submit', async e => {
                    e.preventDefault();
                    const data = new FormData(form);
                    const res = await fetch('@Url.Action("CrearVentaReceta", "Ventas")', { method: 'POST', body: data });
                    const json = await res.json();
                    if (json.success) {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('modalAgregarPartida'));

                        if (modal) {
                            modal.hide();
                        }

                        alert('Partida agregada');
                        location.reload();
                    } else alert('Error al agregar partida');
                });
                form.dataset.loaded = 'true';
            }
        });
    </script>
}