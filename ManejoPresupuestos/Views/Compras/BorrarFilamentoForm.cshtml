@model FilamentoTipo
@{
    ViewData["Title"] = "Borrar Tipo de Filamento";
}

<h3>¿Está seguro de querer borrar el tipo de filamento @Model.Nombre?</h3>
<form asp-action="BorrarFilamento">
    <input type="hidden" asp-for="FilamentoTipoId" />
    <button class="btn btn-danger" type="submit">
        Borrar
    </button>
    <a asp-action="Filamentos" class="btn btn-secondary">
        Cancelar
    </a>
</form>