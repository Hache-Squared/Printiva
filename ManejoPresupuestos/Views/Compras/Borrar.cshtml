@model Compra
@{
    ViewData["Title"] = "Borrar Compra";
}

<h3>¿Está seguro de querer borrar el registro de compra del día @Model.FechaCreacion.ToString("dd/MM/yyyy")?</h3>
<form asp-action="BorrarCompra">
    <input type="hidden" asp-for="CompraId" />
    <button class="btn btn-danger" type="submit">
        Borrar
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>