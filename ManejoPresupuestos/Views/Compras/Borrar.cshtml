@model ManejoPresupuestos.Models.CompraV2
@{
    ViewData["Title"] = "Borrar Compra";
}

<partial name="_Submenu" model="SubMenuCompras.Compras" />

<h3>¿Seguro que quieres borrar (lógico) la compra del día @Model.FechaCreacion.ToString("dd/MM/yyyy")?</h3>

<p><strong>Descripción:</strong> @Model.Descripcion</p>
<p><strong>Total:</strong> @Model.CostoTotal.ToString("0.00")</p>

<form asp-action="BorrarCompra">
    <input type="hidden" name="compraId" value="@Model.CompraId" />
    <button class="btn btn-danger" type="submit">Borrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>