@model CompraTipo
@{
    ViewData["Title"] = "Borrar Tipo de Compra";
}

<h3>¿Está seguro de querer borrar el tipo de compra @Model.Nombre?</h3>
<form asp-action="BorrarTipo">
    <input type="hidden" asp-for="CompraTipoId" />
    <button class="btn btn-danger" type="submit">
        Borrar
    </button>
    <a asp-action="Tipos" class="btn btn-secondary">
        Cancelar
    </a>
</form>