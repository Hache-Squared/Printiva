@model ManejoPresupuestos.Models.CompraCategoriaV2
@{
    ViewData["Title"] = "Borrar Categoría";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
        --danger: #EF4444;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 860px; }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .subnav{ padding: .65rem .75rem; }
    .subnav .nav{ gap: .35rem; }
    .subnav .nav-link{
        border-radius: 999px;
        padding: .5rem .95rem;
        font-weight: 800;
        font-size: .92rem;
        color: var(--muted);
        background: transparent;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .subnav .nav-link:hover{
        color: var(--text);
        background: rgba(15,23,42,.03);
        border-color: rgba(15,23,42,.06);
    }
    .subnav .nav-link.active{
        color: var(--primary);
        background: rgba(29,78,216,.10);
        border-color: rgba(29,78,216,.18);
    }

    .pg-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
        font-size: clamp(1.65rem, 1.25rem + 1vw, 2.2rem);
        line-height: 1.08;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .45rem;
        font-size: .98rem;
    }

    .danger-panel{
        border: 1px solid rgba(239,68,68,.22);
        background: rgba(239,68,68,.06);
        border-radius: 16px;
        padding: 1rem 1rem;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-danger-soft{
        background: rgba(239,68,68,.12);
        border-color: rgba(239,68,68,.22);
        color: #B91C1C;
    }
    .btn-danger-soft:hover{
        background: rgba(239,68,68,.16);
        border-color: rgba(239,68,68,.26);
        color: #991B1B;
    }
    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="card card-soft subnav mb-4">
            <partial name="_Submenu" model="SubMenuCompras.Categorias" />
        </div>

        <div class="card card-soft">
            <div class="card-body p-4">
                <div class="danger-panel">
                    <h3 class="pg-title">¿Seguro que quieres borrar (lógico) la categoría @Model.Nombre?</h3>
                    <div class="pg-subtitle">Esta acción solo desactiva la categoría. No se elimina físicamente.</div>
                </div>

                <form asp-action="BorrarCategoria" class="mt-4">
                    <input type="hidden" name="compraCategoriaId" value="@Model.CompraCategoriaId" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-pill btn-danger-soft" type="submit">Borrar</button>
                        <a asp-action="Categorias" class="btn btn-pill btn-soft">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>