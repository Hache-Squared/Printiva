@model CompraCreacionViewModel
@{
    ViewData["Title"] = "Crear Compra";
}

<h1>Crear compra</h1>
<h5>
    Un registro de compra se refiere a registrar una adquisición de bienes o servicios.
</h5>

<form asp-action="Crear">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CompraCategoriaId" class="form-label"></label>
        <select asp-for="CompraCategoriaId" asp-items="@Model.Categorias" class="form-select"></select>
        <span asp-validation-for="CompraCategoriaId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CompraTipoId" class="form-label"></label>
        <select asp-for="CompraTipoId" asp-items="@Model.Tipos" class="form-select"></select>
        <span asp-validation-for="CompraTipoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FilamentoTipoId" class="form-label"></label>
        <select asp-for="FilamentoTipoId" asp-items="@Model.FilamentoTipos" class="form-select">
            <option value="">Seleccione un tipo de filamento (opcional)</option>
        </select>
        <span asp-validation-for="FilamentoTipoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CostoTotal" class="form-label"></label>
        <input asp-for="CostoTotal" class="form-control" />
        <span asp-validation-for="CostoTotal" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaCreacion" class="form-label"></label>
        <input asp-for="FechaCreacion" class="form-control" />
        <span asp-validation-for="FechaCreacion" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">
        Enviar
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}