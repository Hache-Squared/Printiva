@model CompraCategoria
@{
    ViewData["Title"] = "Crear Categoría de Compra";
}
<h1>Crear categoría de compra</h1>
<h5>
    Una categoría de compra ayuda a clasificar los tipos de gastos.
</h5>

<form asp-action="CrearCategoria">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <button class="btn btn-primary" type="submit">
        Enviar
    </button>
    <a asp-action="Categorias" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}