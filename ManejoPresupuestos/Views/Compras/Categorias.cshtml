@model IEnumerable<CompraCategoria>
@{
    ViewData["Title"] = "Categorías de Compra";
}
<partial name="_Submenu" model="SubMenuCompras.Categorias" />
<h1>Categorías de compra</h1>
<h5>
    Una categoría de compra ayuda a clasificar los tipos de gastos.
</h5>
<a asp-action="CrearCategoria" class="btn btn-primary mb-3">Crear Nueva</a>

<table class="table">
    <thead>
    <th>Acciones</th>
    <th>Nombre</th>
    </thead>
    <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>
                    <a class="btn btn-primary" asp-action="EditarCategoria" asp-route-id="@categoria.CompraCategoriaId">Editar</a>
                    <a class="btn btn-danger" asp-action="BorrarCategoriaForm" asp-route-id="@categoria.CompraCategoriaId">Borrar</a>
                </td>
                <td>
                    @categoria.Nombre
                </td>
            </tr>
        }
    </tbody>
</table>