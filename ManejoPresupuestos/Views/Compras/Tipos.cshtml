@model IEnumerable<CompraTipo>
@{
    ViewData["Title"] = "Tipos de Compra";
}

<partial name="_Submenu" model="SubMenuCompras.Tipos" />
<h1>Tipos de compra</h1>
<h5>
    Un tipo de compra ayuda a clasificar las modalidades de adquisición.
</h5>
<a asp-action="CrearTipo" class="btn btn-primary mb-3">Crear Nuevo</a>
<table class="table">
    <thead>
    <th>Acciones</th>
    <th>Nombre</th>
    </thead>
    <tbody>
        @foreach (var tipo in Model)
        {
            <tr>
                <td>
                    <a class="btn btn-primary" asp-action="EditarTipo" asp-route-id="@tipo.CompraTipoId">Editar</a>
                    <a class="btn btn-danger" asp-action="BorrarTipoForm" asp-route-id="@tipo.CompraTipoId">Borrar</a>
                </td>
                <td>
                    @tipo.Nombre
                </td>
            </tr>
        }
    </tbody>
</table>