@model ManejoPresupuestos.Models.CompraTipoV2
@{
    ViewData["Title"] = "Crear Tipo de Compra";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 860px; }

    .pg-title{
        color: var(--text);
        font-weight: 850;
        letter-spacing: -.02em;
        font-size: clamp(1.9rem, 1.45rem + 1.1vw, 2.6rem);
        line-height: 1.08;
        margin: 0;
    }

    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
        max-width: 80ch;
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .subnav{ padding: .65rem .75rem; }
    .subnav .nav{ gap: .35rem; }
    .subnav .nav-link{
        border-radius: 999px;
        padding: .5rem .95rem;
        font-weight: 800;
        font-size: .92rem;
        color: var(--muted);
        background: transparent;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .subnav .nav-link:hover{
        color: var(--text);
        background: rgba(15,23,42,.03);
        border-color: rgba(15,23,42,.06);
    }
    .subnav .nav-link.active{
        color: var(--primary);
        background: rgba(29,78,216,.10);
        border-color: rgba(29,78,216,.18);
    }

    .control-soft{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .72rem;
        padding-bottom: .72rem;
    }
    .control-soft:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 800;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .hint{
        color: var(--muted);
        font-size: .9rem;
        margin-top: .35rem;
    }

    .check-soft{
        border: 1px solid rgba(15,23,42,.12);
        background: rgba(15,23,42,.02);
        border-radius: 14px;
        padding: .9rem 1rem;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="card card-soft subnav mb-4">
            <partial name="_Submenu" model="SubMenuCompras.Tipos" />
        </div>

        <div class="mb-4">
            <h1 class="pg-title">Crear tipo de compra</h1>
            <div class="pg-subtitle">Define si este tipo requiere inventario (cantidad + costo unitario).</div>
        </div>

        <div class="card card-soft">
            <div class="card-body p-4">
                <form asp-action="CrearTipo">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control control-soft" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="check-soft mb-3">
                        <div class="form-check m-0">
                            <input class="form-check-input" asp-for="EsInventario" />
                            <label class="form-check-label fw-semibold" asp-for="EsInventario">Afecta inventario</label>
                        </div>
                        <div class="hint">Si está activo, en Compras se pedirá inventario + cantidad + costo unitario.</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary btn-pill btn-primary-pill" type="submit">Enviar</button>
                        <a asp-action="Tipos" class="btn btn-pill btn-soft">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}