@model ManejoPresupuestos.Models.Cliente

@{
    ViewData["Title"] = "Borrar cliente";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --primary: #1D4ED8;
        --danger: #EF4444;
        --warn: #F59E0B;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 920px; }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .pg-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
        font-size: clamp(1.65rem, 1.25rem + 1vw, 2.25rem);
        line-height: 1.08;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .45rem;
        font-size: .98rem;
        max-width: 90ch;
    }

    .warn-panel{
        border: 1px solid rgba(245,158,11,.22);
        background: rgba(245,158,11,.10);
        border-radius: 16px;
        padding: .95rem 1rem;
    }
    .danger-panel{
        border: 1px solid rgba(239,68,68,.22);
        background: rgba(239,68,68,.06);
        border-radius: 16px;
        padding: 1rem 1rem;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-danger-soft{
        background: rgba(239,68,68,.12);
        border-color: rgba(239,68,68,.22);
        color: #B91C1C;
    }
    .btn-danger-soft:hover{
        background: rgba(239,68,68,.16);
        border-color: rgba(239,68,68,.26);
        color: #991B1B;
    }
    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="mb-4">
            <h1 class="pg-title">Borrar cliente</h1>
            <div class="pg-subtitle">Confirma la desactivación del cliente.</div>
        </div>

        <div class="card card-soft">
            <div class="card-body p-4">

                @if (!Model.EstaActivo)
                {
                    <div class="warn-panel mb-3">
                        <div class="fw-semibold">Este cliente ya está inactivo.</div>
                        <div class="text-muted small">Puedes regresar sin hacer cambios.</div>
                    </div>
                }

                <div class="danger-panel">
                    ¿Seguro que quieres desactivar a <strong>@Model.Nombre</strong>?
                    <div class="small text-muted">Esto es borrado lógico: no se elimina de la base.</div>
                </div>

                <form asp-action="BorrarCliente" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clienteId" value="@Model.ClienteId" />

                    <div class="d-flex gap-2">
                        <button class="btn btn-pill btn-danger-soft" type="submit">Desactivar</button>
                        <a asp-action="Index" class="btn btn-pill btn-soft">Cancelar</a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>