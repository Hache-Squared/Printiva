@model IEnumerable<RecetaMostarIndex>
@{
    ViewData["Title"] = "Recetas";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
    }

    body{ background: var(--pg-bg); }

    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 850;
        letter-spacing: -.02em;
        font-size: clamp(2rem, 1.5rem + 1.35vw, 2.9rem);
        line-height: 1.05;
        margin: 0;
    }

    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
        max-width: 80ch;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 800;
        font-size: .92rem;
        white-space: nowrap;
    }
    /* más compactos para que quepan en filas */
    .btn-pill.btn-sm{
        padding: .32rem .65rem;
        font-size: .80rem;
        line-height: 1.15;
    }

    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }

    .btn-danger-soft{
        background: rgba(239,68,68,.10);
        border-color: rgba(239,68,68,.18);
        color: #B91C1C;
    }
    .btn-danger-soft:hover{
        background: rgba(239,68,68,.14);
        border-color: rgba(239,68,68,.22);
        color: #991B1B;
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .table-clean{ margin: 0; }

    /* headers más delgados */
    .table-clean thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .70rem;
        text-transform: uppercase;
        padding: .65rem .75rem;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    /* filas más compactas */
    .table-clean tbody td{
        padding: .55rem .75rem;
        border-top: 1px solid rgba(15,23,42,.06);
        vertical-align: middle;
        font-size: .92rem;
    }

    /* reduce altura visual de cada row */
    .table-clean tbody tr{ line-height: 1.15; }

    .act-wrap{
        display:flex;
        gap:.35rem;
        flex-wrap:wrap;
        white-space: nowrap;
    }

    .producto-nombre{
        color: var(--text);
        font-weight: 800;
    }

    .cell-truncate{
        max-width: 360px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .modal-content{
        border: 0;
        border-radius: 18px;
        box-shadow: 0 18px 60px rgba(2,6,23,.25);
    }
    .modal-header{
        border-bottom: 1px solid var(--border);
    }
    .modal-title{
        font-weight: 850;
        color: var(--text);
    }
    .control-soft{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .72rem;
        padding-bottom: .72rem;
    }
    .control-soft:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Recetas</h1>
                <div class="pg-subtitle">Una Receta es la composición de materiales de tu inventario para un producto.</div>
            </div>

            <a asp-action="RecetaEditor" class="btn btn-primary btn-pill btn-primary-pill">Crear Nuevo</a>
        </div>

        <div class="card card-soft">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-clean align-middle">
                        <thead>
                            <tr>
                                <th style="width: 230px;">Acciones</th>
                                <th>Nombre</th>
                                <th style="width: 150px;">Tiempos</th>
                                <th style="min-width: 440px;">Producto</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var receta in Model)
                        {
                            <tr>
                                <td>
                                    <div class="act-wrap">
                                        <a class="btn btn-primary btn-pill btn-primary-pill btn-sm"
                                           asp-action="RecetaEditorUpdate"
                                           asp-route-recetaId="@receta.RecetaId">Editar</a>

                                        <button class="btn btn-pill btn-danger-soft btn-sm"
                                                onclick="desactivarReceta(@receta.RecetaId)">Borrar</button>

                                        <button class="btn btn-pill btn-soft btn-sm"
                                                onclick="duplicarReceta(@receta.RecetaId)">Duplicar</button>
                                    </div>
                                </td>

                                <td class="fw-semibold">@receta.Nombre</td>

                                <td style="white-space:nowrap;">
                                    <span class="fw-semibold">@receta.TiempoImpresionMin min</span>
                                    <span class="text-muted">/ post: @receta.TiempoPostMin</span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                        <div class="producto-nombre cell-truncate">
                                            @(string.IsNullOrEmpty(receta.ProductoNombre) ? "Sin asignar" : receta.ProductoNombre)
                                        </div>

                                        <div class="d-flex gap-2 flex-wrap">
                                            <button class="btn btn-pill btn-soft btn-sm"
                                                    onclick="abrirModalSeleccionProducto(@receta.RecetaId, '@receta.Nombre', @receta.TiempoImpresionMin, @receta.TiempoPostMin)">
                                                @(string.IsNullOrEmpty(receta.ProductoNombre) ? "Asignar" : "Actualizar")
                                            </button>

                                            @if (!string.IsNullOrEmpty(receta.ProductoNombre) && receta.ProductoId != 0)
                                            {
                                                <button class="btn btn-pill btn-danger-soft btn-sm"
                                                        onclick="quitarRelacionProducto(@receta.RecetaId, '@receta.Nombre', @receta.TiempoImpresionMin, @receta.TiempoPostMin)">
                                                    Quitar
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalSeleccionProducto" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Seleccionar Producto</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input id="buscarProducto" type="text" class="form-control control-soft mb-3" placeholder="Buscar por nombre o SKU...">

                        <div class="table-responsive">
                            <table class="table table-clean table-hover align-middle mb-0" id="tablaProductos">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Categoría</th>
                                        <th>SKU</th>
                                        <th style="width: 140px;" class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="productosList"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let productosCache = [];

        async function abrirModalSeleccionProducto(recetaId, nombre, tiempoImpMin, tiempoPostMin) {
            $('#modalSeleccionProducto')
                .data('receta-id', recetaId)
                .data('receta-nombre', nombre)
                .data('receta-tiempo-imp', tiempoImpMin ?? 0)
                .data('receta-tiempo-post', tiempoPostMin ?? 0);

            $('#modalSeleccionProducto').modal('show');
            await cargarProductos(recetaId, nombre, tiempoImpMin, tiempoPostMin);
        }

        async function cargarProductos(recetaId, nombre, tiempoImpMin, tiempoPostMin) {
            if (productosCache.length === 0) {
                const resp = await fetch('@Url.Action("ObtenerProductos")');
                productosCache = await resp.json();
            }
            renderProductos(productosCache, recetaId, nombre, tiempoImpMin, tiempoPostMin);
        }

        function renderProductos(lista, recetaId, nombre, tiempoImpMin, tiempoPostMin) {
            const html = lista.map(p => `
                <tr>
                    <td class="fw-semibold">${p.nombre}</td>
                    <td>${p.productoCategoria ?? '-'}</td>
                    <td>${p.sku ?? '-'}</td>
                    <td class="text-end">
                        <button class="btn btn-primary btn-pill btn-primary-pill btn-sm"
                            onclick="asignarProducto(${p.productoId}, ${recetaId}, '${escapeHtml(nombre)}', ${tiempoImpMin ?? 0}, ${tiempoPostMin ?? 0})">
                            Seleccionar
                        </button>
                    </td>
                </tr>
            `).join('');
            $('#productosList').html(html);
        }

        $('#buscarProducto').on('input', function () {
            const texto = $(this).val().toLowerCase();
            const filtrados = productosCache.filter(p =>
                p.nombre.toLowerCase().includes(texto) ||
                (p.sku ?? '').toLowerCase().includes(texto)
            );

            const recetaId = $('#modalSeleccionProducto').data('receta-id');
            const nombre = $('#modalSeleccionProducto').data('receta-nombre');
            const tiempoImpMin = $('#modalSeleccionProducto').data('receta-tiempo-imp') ?? 0;
            const tiempoPostMin = $('#modalSeleccionProducto').data('receta-tiempo-post') ?? 0;

            renderProductos(filtrados, recetaId, nombre, tiempoImpMin, tiempoPostMin);
        });

        async function asignarProducto(productoId, recetaId, nombre, tiempoImpMin, tiempoPostMin) {
            const body = {
                RecetaId: recetaId,
                ProductoId: productoId,
                Nombre: nombre,
                TiempoImpresionMin: tiempoImpMin ?? 0,
                TiempoPostMin: tiempoPostMin ?? 0,
                Tiempo: String(tiempoImpMin ?? 0)
            };

            const resp = await fetch('@Url.Action("AsignarProductoAReceta")', {
                method: 'POST',
                body: JSON.stringify(body),
                headers: { 'Content-Type': 'application/json' }
            });

            const json = await resp.json();

            if (json.result === 'success') {
                $('#modalSeleccionProducto').modal('hide');
                location.reload();
            } else {
                alert(json.message ?? 'Error asignando producto');
            }
        }

        async function quitarRelacionProducto(recetaId, nombre, tiempoImpMin, tiempoPostMin) {
            if (!confirm("¿Seguro que deseas quitar el producto asociado a esta receta?")) return;

            const body = {
                RecetaId: recetaId,
                ProductoId: 0,
                Nombre: nombre,
                TiempoImpresionMin: tiempoImpMin ?? 0,
                TiempoPostMin: tiempoPostMin ?? 0,
                Tiempo: String(tiempoImpMin ?? 0)
            };

            const resp = await fetch('@Url.Action("AsignarProductoAReceta")', {
                method: 'POST',
                body: JSON.stringify(body),
                headers: { 'Content-Type': 'application/json' }
            });

            const json = await resp.json();

            if (json.result === 'success') {
                location.reload();
            } else {
                alert(json.message ?? 'Error quitando producto');
            }
        }

        function escapeHtml(text) {
            return text?.replace(/'/g, "\\'") ?? '';
        }

        async function duplicarReceta(recetaIdOrigen) {
            if (!confirm("¿Seguro que deseas duplicar esta receta?")) return;
            const nombreNuevo = prompt("Nombre para la copia (deja vacío para auto):", "");
            const resp = await fetch('@Url.Action("ReplicarReceta")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ RecetaIdOrigen: recetaIdOrigen, NombreNuevo: nombreNuevo || null })
            });

            const json = await resp.json();
            if (json.result === 'success') {
                window.location.href = '@Url.Action("RecetaEditorUpdate")' + '?recetaId=' + json.recetaId;
            } else {
                alert(json.message ?? 'Error duplicando receta');
            }
        }

        async function desactivarReceta(recetaId) {
            if (!confirm("¿Seguro que deseas desactivar esta receta?")) return;

            const resp = await fetch('@Url.Action("DesactivarReceta")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ RecetaId: recetaId })
            });

            const json = await resp.json();

            if (json.result === 'success') {
                location.reload();
            } else {
                alert(json.message ?? 'Error desactivando receta');
            }
        }
    </script>
}