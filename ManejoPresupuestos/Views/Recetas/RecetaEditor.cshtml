@using Newtonsoft.Json
@model IEnumerable<InventarioParaReceta>

@{
    ViewData["Title"] = "Editar receta";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
    }

    body{ background: var(--pg-bg); }

    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 850;
        letter-spacing: -.02em;
        font-size: clamp(2rem, 1.5rem + 1.35vw, 2.9rem);
        line-height: 1.05;
        margin: 0;
    }

    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
        max-width: 85ch;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 800;
        font-size: .92rem;
        white-space: nowrap;
    }

    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .section-title{
        color: var(--text);
        font-weight: 850;
        margin: 0;
    }

    .form-label{
        color: var(--text);
        font-weight: 750;
        margin-bottom: .45rem;
    }

    .control-soft{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .72rem;
        padding-bottom: .72rem;
    }
    .control-soft:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .panel-note{
        color: var(--muted);
        font-size: .9rem;
    }

    .list-wrap{
        border: 1px solid var(--border2);
        background: rgba(15,23,42,.02);
        border-radius: 16px;
        padding: .85rem;
        overflow-y: auto;
        max-height: 64vh;
    }

    .mini-muted{
        color: var(--muted);
        font-size: .85rem;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="card card-soft mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                    <div>
                        <h1 class="pg-title">Editar receta</h1>
                        <div class="pg-subtitle">Define el nombre, el tiempo de impresión y selecciona los materiales de inventario.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-pill btn-soft">Cancelar</a>
                        <a id="btn-guardar-receta" class="btn btn-primary btn-pill btn-primary-pill">Guardar</a>
                    </div>
                </div>

                <input id="receta-id" type="hidden" value="@(ViewBag.Receta != null ? ViewBag.Receta.Id : 0)" />

                <div class="row g-3 mt-2">
                    <div class="col-lg-7">
                        <label class="form-label">Nombre de la receta</label>
                        <input id="nombre-receta" type="text" class="form-control control-soft"
                               placeholder="Carrito/Casco Ingeniero ..."
                               value="@(ViewBag.Receta != null ? ViewBag.Receta.Nombre : "")" />
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label">Tiempo de impresión (min)</label>
                        <input id="tiempo-receta" class="form-control control-soft" type="number" min="1" step="1"
                               placeholder="40"
                               value="@(ViewBag.Receta != null ? ViewBag.Receta.TiempoImpresionMin : 0)" />
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label">Post (min)</label>
                        <input id="tiempo-post-receta" class="form-control control-soft" type="number" min="0" step="1"
                               value="@(ViewBag.Receta != null ? ViewBag.Receta.TiempoPostMin : 0)" />
                    </div>
                </div>

                @* <div class="panel-note mt-2">
                    * Click en un material para agregarlo o quitarlo (sin drag).
                </div> *@
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card card-soft h-100">
                    <div class="card-body p-3 p-md-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            <div>
                                <h5 class="section-title">Materiales disponibles</h5>
                                @* <div class="mini-muted">Click para agregar</div> *@
                            </div>
                        </div>

                        <div class="list-wrap mt-3 flex-grow-1" id="left"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card card-soft h-100">
                    <div class="card-body p-3 p-md-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            <div>
                                <h5 class="section-title">Materiales en la receta</h5>
                                @* <div class="mini-muted">Click para quitar</div> *@
                            </div>
                        </div>

                        <div class="list-wrap mt-3 flex-grow-1" id="right"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ControladorRecetaEditor.js" asp-append-version="true"></script>

    <script>
        const urlRecetaGuardar = '@Url.Action("RecetaEditorGuardar")';

        let items = @Html.Raw(JsonConvert.SerializeObject(Model));
        let itemsSeleccionados = @Html.Raw(JsonConvert.SerializeObject(ViewBag.MaterialesSeleccionados ?? new List<object>()));

        itemsSeleccionados = itemsSeleccionados?.map(x => {
            return {
                ...x,
                cantidadRequerida: x?.CantidadAsignada ?? 0
            }
        });

        $(function () {
            const recetaId = parseInt($("#receta-id").val()) || 0;
            if (recetaId > 0) {
                $("#btn-guardar-receta").text("Actualizar");
            }

            ControladorRecetaEditor.LimpiarLocalStorage();
            ControladorRecetaEditor.inicializarListas(items, itemsSeleccionados);
            ControladorRecetaEditor.inicializarListener(urlRecetaGuardar);
        });
    </script>
}