@model ManejoPresupuestos.Models.ReporteCxcViewModel
@{
    ViewData["Title"] = "Pagos pendientes";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);

        --primary: #1D4ED8;
        --success: #16A34A;
        --warning: #F59E0B;

        --shadow: 0 10px 30px rgba(2,6,23,.08);
        --radius: 18px;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 1.45rem + 1.25vw, 2.75rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 92ch;
    }

    .card{
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: var(--card-bg);
    }
    .card-header{
        background: transparent;
        border-bottom: 1px solid var(--border);
        padding: .95rem 1.1rem;
        font-weight: 900;
        color: var(--text);
    }
    .card-body{ padding: 1.1rem; }

    .form-label{
        font-weight: 900;
        color: var(--text);
    }
    .form-control, .form-select{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .68rem;
        padding-bottom: .68rem;
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .btn{
        border-radius: 999px;
        font-weight: 850;
    }
    .btn-primary{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-success{
        background: rgba(22,163,74,.12);
        border-color: rgba(22,163,74,.22);
        color: #166534;
        font-weight: 900;
    }
    .btn-success:hover{
        background: rgba(22,163,74,.16);
        border-color: rgba(22,163,74,.26);
        color: #14532D;
    }
    .btn-outline-secondary{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-outline-secondary:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn:focus{
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
    }

    .form-check-input{
        border-color: rgba(15,23,42,.22);
    }
    .form-check-input:checked{
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .table thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        padding-top: .6rem !important;
        padding-bottom: .6rem !important;
    }
    .table tbody td{
        border-top: 1px solid var(--border2);
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
        vertical-align: middle;
        font-size: .95rem;
        color: var(--text);
    }

    .badge{
        border-radius: 999px;
        font-weight: 900;
        padding: .34rem .55rem;
        letter-spacing: .01em;
    }
    .badge.bg-secondary{
        background: rgba(100,116,139,.14) !important;
        color: #334155 !important;
        border: 1px solid rgba(100,116,139,.22);
    }
    .badge.bg-warning.text-dark{
        background: rgba(245,158,11,.16) !important;
        border: 1px solid rgba(245,158,11,.22);
        color: #7C2D12 !important;
    }
    .badge.bg-danger{
        background: rgba(239,68,68,.14) !important;
        border: 1px solid rgba(239,68,68,.22);
        color: #991B1B !important;
    }
    .badge.bg-success{
        background: rgba(22,163,74,.14) !important;
        border: 1px solid rgba(22,163,74,.22);
        color: #166534 !important;
    }
    .badge.bg-light.text-dark{
        background: rgba(15,23,42,.03) !important;
        border: 1px solid rgba(15,23,42,.10);
        color: var(--text) !important;
    }

    a{
        color: color-mix(in srgb, var(--primary) 88%, #000);
        font-weight: 900;
        text-decoration: none;
    }
    a:hover{ text-decoration: underline; }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h1 class="pg-title mb-0">Pagos pendientes</h1>
                <div class="pg-subtitle">Aging, saldo por pedido y detalle de cuentas por cobrar.</div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @{
                    string fmtDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
                }

                <a class="btn btn-success"
                   asp-controller="Reportes"
                   asp-action="CxcExcel"
                   asp-route-desde="@fmtDate(Model.Desde)"
                   asp-route-hasta="@fmtDate(Model.Hasta)"
                   asp-route-clienteId="@Model.ClienteId"
                   asp-route-pedidoId="@Model.PedidoId"
                   asp-route-soloVencidos="@Model.SoloVencidos"
                   asp-route-bucketId="@Model.BucketId"
                   asp-route-metodo="@Model.Metodo"
                   asp-route-minSaldo="@Model.MinSaldo">
                    Exportar Excel
                </a>
                <a class="btn btn-outline-secondary" href="/Reportes">Volver</a>
            </div>
        </div>

        <form class="card card-body mb-3" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd") ?? "")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd") ?? "")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Cliente</label>
                    <select class="form-select" name="clienteId">
                        <option value="">-- Todos --</option>
                        @foreach (var c in Model.Clientes)
                        {
                            <option value="@c.Id" selected="@(Model.ClienteId == c.Id)">
                                @c.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">PedidoId</label>
                    <input class="form-control" name="pedidoId" value="@(Model.PedidoId?.ToString() ?? "")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Método / Ref / Tipo (texto)</label>
                    <input class="form-control" name="metodo" placeholder="Ej: efectivo, transferencia, BBVA..."
                           value="@(Model.Metodo ?? "")" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Min saldo($)</label>
                    <input class="form-control" name="minSaldo" value="@(Model.MinSaldo?.ToString("0.##") ?? "")" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Bucket</label>
                    <select class="form-select" name="bucketId">
                        <option value="">-- Todos --</option>
                        <option value="0" selected="@(Model.BucketId == 0)">No vencido</option>
                        <option value="1" selected="@(Model.BucketId == 1)">1-7</option>
                        <option value="2" selected="@(Model.BucketId == 2)">8-14</option>
                        <option value="3" selected="@(Model.BucketId == 3)">15-30</option>
                        <option value="4" selected="@(Model.BucketId == 4)">31-60</option>
                        <option value="5" selected="@(Model.BucketId == 5)">61+</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" name="soloVencidos" value="true"
                               checked="@(Model.SoloVencidos)" id="soloVencidos" />
                        <label class="form-check-label" for="soloVencidos">Solo vencidos</label>
                    </div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-2 flex-wrap">
                    <button class="btn btn-primary" type="submit">Filtrar</button>
                    <a class="btn btn-outline-secondary" href="/Reportes/Cxc">Limpiar</a>
                </div>
            </div>
        </form>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Pedidos con saldo</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.PedidosConSaldo</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Saldo total</div>
                    <div class="fs-4 fw-semibold">$@((Model.Totales.SaldoTotal ?? 0).ToString("N2"))</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Pedidos vencidos</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.PedidosVencidos</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Saldo vencido</div>
                    <div class="fs-4 fw-semibold">$@((Model.Totales.SaldoVencido ?? 0).ToString("N2"))</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Aging buckets</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Bucket</th>
                            <th class="text-end">Pedidos</th>
                            <th class="text-end">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var b in Model.Buckets)
                    {
                        <tr>
                            <td>@b.BucketNombre</td>
                            <td class="text-end">@b.Pedidos</td>
                            <td class="text-end">$@((b.Saldo ?? 0).ToString("N2"))</td>
                        </tr>
                    }
                    @if (!Model.Buckets.Any())
                    {
                        <tr><td colspan="3" class="text-muted text-center py-3">Sin datos</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Detalle (pedidos con saldo)</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Estatus</th>
                            <th>Fecha base</th>
                            <th class="text-end">Días</th>
                            <th>Bucket</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Pagado</th>
                            <th class="text-end">Saldo</th>
                            <th class="text-end">Pagado %</th>
                            <th>Último pago</th>
                            <th>Método</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>
                                <a href="/Reportes/Pedido360?pedidoId=@r.PedidoId">@r.PedidoId</a>
                            </td>
                            <td>@r.ClienteNombre</td>
                            <td>@r.PedidoEstatusNombre</td>
                            <td>@r.FechaBase.ToString("dd-MM-yyyy")</td>
                            <td class="text-end">@r.DiasVencidos</td>
                            <td>@r.BucketNombre</td>
                            <td class="text-end">$@r.TotalCobro.ToString("N2")</td>
                            <td class="text-end">$@r.TotalPagado.ToString("N2")</td>
                            <td class="text-end fw-semibold">$@r.Saldo.ToString("N2")</td>
                            <td class="text-end">@r.PagadoPct.ToString("N2")%</td>
                            <td>@(r.UltimoPagoFecha?.ToString("dd-MM-yyyy") ?? "-")</td>
                            <td>@(r.UltimoPagoMetodo ?? r.UltimoPagoTipoNombre ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="12" class="text-muted text-center py-3">Sin datos</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-muted small mt-3">
            * Fecha base = Vigencia cotización &gt; Fecha creación cotización &gt; Fecha creación pedido.
        </div>

    </div>
</div>