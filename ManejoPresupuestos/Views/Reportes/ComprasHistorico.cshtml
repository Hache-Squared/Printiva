@model ManejoPresupuestos.Models.ReporteComprasHistoricoVm

@functions {
    string money(decimal v) => v.ToString("C2");
    string qty(decimal v) => v.ToString("#,0.####");
    string qtyN(decimal? v) => v.HasValue ? v.Value.ToString("#,0.####") : "—";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);

        --primary: #1D4ED8;
        --success: #16A34A;
        --info: #0891B2;
        --warning: #F59E0B;
        --danger: #EF4444;

        --shadow: 0 10px 30px rgba(2,6,23,.08);
        --radius: 18px;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1320px; }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(1.75rem, 1.25rem + 1.2vw, 2.35rem);
        line-height: 1.08;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 100ch;
    }

    .card{
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: var(--card-bg);
    }
    .card-header{
        background: transparent !important;
        border-bottom: 1px solid var(--border);
        padding: .95rem 1.1rem;
        font-weight: 900;
        color: var(--text);
    }
    .card-body{ padding: 1.1rem; }

    .form-label{
        font-weight: 900;
        color: var(--text);
    }
    .form-control, .form-select, .input-group-text{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
    }
    .form-control, .form-select{
        background: rgba(15,23,42,.03);
        padding-top: .68rem;
        padding-bottom: .68rem;
    }
    .input-group-text{
        background: rgba(15,23,42,.03);
        color: var(--muted);
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .btn{
        border-radius: 999px;
        font-weight: 850;
        white-space: nowrap;
    }
    .btn-primary{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-success{
        background: rgba(22,163,74,.12);
        border-color: rgba(22,163,74,.22);
        color: #166534;
        font-weight: 900;
    }
    .btn-success:hover{
        background: rgba(22,163,74,.16);
        border-color: rgba(22,163,74,.26);
        color: #14532D;
    }
    .btn-outline-secondary{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-outline-secondary:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn:focus{
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
    }

    .kpi-card{
        background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.92));
    }
    .kpi-label{
        color: var(--muted);
        font-weight: 900;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
    }
    .kpi-value{
        color: var(--text);
        font-weight: 950;
    }

    .table thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        padding-top: .6rem !important;
        padding-bottom: .6rem !important;
        background: transparent !important;
    }
    .table tbody td{
        border-top: 1px solid var(--border2);
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
        vertical-align: middle;
        font-size: .95rem;
        color: var(--text);
    }

    .table-hover tbody tr:hover{
        background: rgba(29,78,216,.04);
    }

    .badge{
        border-radius: 999px;
        font-weight: 900;
        letter-spacing: .01em;
    }
    .badge.bg-secondary{
        background: rgba(100,116,139,.14) !important;
        color: #334155 !important;
    }
    .badge.bg-success{
        background: rgba(22,163,74,.14) !important;
        color: #166534 !important;
    }
    .badge.bg-danger{
        background: rgba(239,68,68,.14) !important;
        color: #991B1B !important;
    }

    a{
        color: color-mix(in srgb, var(--primary) 88%, #000);
        font-weight: 900;
        text-decoration: none;
    }
    a:hover{ text-decoration: underline; }

    .text-primary{ color: var(--primary) !important; }
    .text-info{ color: var(--info) !important; }
    .text-success{ color: var(--success) !important; }

    .table-danger{
        background: rgba(239,68,68,.08) !important;
    }

    .border-start.border-4{
        border-left-width: 4px !important;
        border-left-style: solid !important;
    }
    .border-info{ border-color: rgba(8,145,178,.45) !important; }
    .border-success{ border-color: rgba(22,163,74,.45) !important; }
    .border-primary{ border-color: rgba(29,78,216,.45) !important; }
    .border-secondary{ border-color: rgba(100,116,139,.35) !important; }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h1 class="pg-title mb-0">
                    Compras Histórico
                </h1>
                <div class="pg-subtitle">Histórico de compras, afectación a inventario y estimaciones.</div>
            </div>

            <div>
                <a class="btn btn-outline-secondary" href="/Reportes">Volver</a>
            </div>
        </div>

        <form method="get" class="card mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">

                    <div class="col-md-2 col-sm-6">
                        <label class="form-label">Desde</label>
                        <input type="date" name="desde" class="form-control"
                               value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <label class="form-label">Hasta</label>
                        <input type="date" name="hasta" class="form-control"
                               value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Categoría</label>
                        <select class="form-select" name="categoriaId">
                            <option value="">(Todas)</option>
                            @foreach (var c in Model.Categorias)
                            {
                                if (Model.CategoriaId == c.Id)
                                {
                                    <option value="@c.Id" selected="selected">@c.Nombre</option>
                                }
                                else
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" name="tipoId">
                            <option value="">(Todos)</option>
                            @foreach (var t in Model.Tipos)
                            {
                                if (Model.TipoId == t.Id)
                                {
                                    <option value="@t.Id" selected="selected">@t.Nombre</option>
                                }
                                else
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Afectó inventario</label>
                        <select class="form-select" name="soloInventario">
                            @if (Model.SoloInventario == null)
                            {
                                <option value="" selected="selected">(Todos)</option>
                                <option value="true">Sí (entró a stock)</option>
                                <option value="false">No (gasto general)</option>
                            }
                            else if (Model.SoloInventario == true)
                            {
                                <option value="">(Todos)</option>
                                <option value="true" selected="selected">Sí (entró a stock)</option>
                                <option value="false">No (gasto general)</option>
                            }
                            else
                            {
                                <option value="">(Todos)</option>
                                <option value="true">Sí (entró a stock)</option>
                                <option value="false" selected="selected">No (gasto general)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Estatus</label>
                        <select class="form-select" name="soloActivos">
                            @if (Model.SoloActivos == null)
                            {
                                <option value="" selected="selected">(Todos)</option>
                                <option value="true">Activos</option>
                                <option value="false">Anulados</option>
                            }
                            else if (Model.SoloActivos == true)
                            {
                                <option value="">(Todos)</option>
                                <option value="true" selected="selected">Activos</option>
                                <option value="false">Anulados</option>
                            }
                            else
                            {
                                <option value="">(Todos)</option>
                                <option value="true">Activos</option>
                                <option value="false" selected="selected">Anulados</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Inventario (opcional)</label>
                        <select class="form-select" name="inventarioId">
                            <option value="">(Todos)</option>
                            @foreach (var inv in Model.Inventarios)
                            {
                                if (Model.InventarioId == inv.Id)
                                {
                                    <option value="@inv.Id" selected="selected">@inv.Nombre</option>
                                }
                                else
                                {
                                    <option value="@inv.Id">@inv.Nombre</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Buscar</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control"
                                   value="@Model.Q"
                                   placeholder="Descripción, categoría, tipo..." />
                        </div>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label">Top</label>
                        <input type="number" name="topN" class="form-control" value="@Model.TopN" min="1" />
                    </div>

                    <div class="col-md-12 text-end d-flex justify-content-end gap-2 flex-wrap">
                        <a class="btn btn-success"
                           asp-action="ComprasHistoricoExcel"
                           asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
                           asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))"
                           asp-route-compraId="@Model.CompraId"
                           asp-route-categoriaId="@Model.CategoriaId"
                           asp-route-tipoId="@Model.TipoId"
                           asp-route-inventarioId="@Model.InventarioId"
                           asp-route-soloActivos="@Model.SoloActivos"
                           asp-route-soloInventario="@Model.SoloInventario"
                           asp-route-topN="@Model.TopN"
                           asp-route-q="@Model.Q">
                            <i class="bi bi-file-earmark-excel"></i> Exportar Excel
                        </a>

                        <a href="@Url.Action("ComprasHistorico")" class="btn btn-outline-secondary">Limpiar</a>

                        <button class="btn btn-primary px-4" type="submit">
                            <i class="bi bi-filter"></i> Aplicar Filtros
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-start border-info border-4 kpi-card">
                    <div class="card-body">
                        <div class="kpi-label">Total Compras</div>
                        <div class="fs-4 kpi-value">@Model.Kpis.Compras</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-start border-success border-4 kpi-card">
                    <div class="card-body">
                        <div class="kpi-label">Gasto Total</div>
                        <div class="fs-4 kpi-value text-success">@money(Model.Kpis.GastoTotal)</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-start border-primary border-4 kpi-card">
                    <div class="card-body">
                        <div class="kpi-label">Compras a Inventario</div>
                        <div class="fs-4 kpi-value">@Model.Kpis.ComprasInventario</div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-start border-secondary border-4 kpi-card">
                    <div class="card-body">
                        <div class="kpi-label">Cantidad total a stock</div>
                        <div class="fs-4 kpi-value">@qty(Model.Kpis.CantidadTotalInventario)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Detalle de Transacciones</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>#</th>
                                <th>Categoría</th>
                                <th>Tipo</th>
                                <th>Descripción</th>
                                <th class="text-end">Cant.</th>
                                <th class="text-end">Costo U.</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Inv.</th>
                                <th class="text-end text-info">Antes</th>
                                <th class="text-end text-primary">Después</th>
                                <th class="text-center">Estatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Detalle)
                            {
                                <tr class="@(!x.EstaActivo ? "table-danger opacity-75" : "")">
                                    <td>@x.FechaCompraFinal.ToString("dd/MM/yy")</td>
                                    <td><span class="badge bg-secondary">@x.CompraId</span></td>
                                    <td><small>@x.CategoriaNombre</small></td>
                                    <td><small>@x.TipoNombre</small></td>
                                    <td>@x.CompraDescripcion</td>
                                    <td class="text-end fw-bold">@qty(x.CantidadFinal)</td>
                                    <td class="text-end">@money(x.CostoUnitarioFinal)</td>
                                    <td class="text-end fw-bold">@money(x.CostoTotalFinal)</td>
                                    <td class="text-center">
                                        <i class="bi @(x.AfectoInventario ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted")"></i>
                                    </td>
                                    <td class="text-end text-info">@qtyN(x.InventarioAntes)</td>
                                    <td class="text-end text-primary">@qtyN(x.InventarioDespues)</td>
                                    <td class="text-center">
                                        @if (x.EstaActivo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>