@model ManejoPresupuestos.Models.ReportesIndexViewModel

@{
    ViewData["Title"] = "Reportes";
}

<div class="container py-4">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-1">Reportes</h1>
            <div class="text-muted">Resumen operativo y accesos rápidos.</div>
        </div>
        <div class="text-muted small">
            @DateTime.UtcNow.ToString("dd/MM/yyyy HH:mm") UTC
        </div>
    </div>

    @* Menú / accesos a reportes *@
    <div class="card mb-4">
        <div class="card-header fw-semibold"> Reportes disponibles</div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary" href="/Reportes/Produccion">Dashboard producción</a>
                <a class="btn btn-outline-primary" href="/Reportes/Pedido360">Pedido 360</a>
                <a class="btn btn-outline-primary" href="/Reportes/PedidosOperativos">Pedidos operativos</a>
                <a class="btn btn-outline-primary" href="/Reportes/Cxc">Pagos y CxC (Aging)</a>
                <a class="btn btn-outline-primary" href="/Reportes/Cotizaciones">Cotizaciones: conversión y seguimiento</a>
                <a class="btn btn-outline-primary" href="/Reportes/ProduccionUtilizacion">Producción: Utilización por impresora</a>
                <a class="btn btn-outline-primary" href="/Reportes/InventarioConsumoMejorado">Inventario - Consumo</a>
                <a class="btn btn-outline-primary" href="/Reportes/ComprasHistorico">Compras Histórico</a>
            </div>
        </div>
    </div>

    @* KPIs *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Pedidos activos</div>
                    <div class="fs-3 fw-bold">@Model.Kpis.PedidosActivos</div>
                    @if (Model.Kpis.PedidosVencidos > 0)
                    {
                        <span class="badge bg-danger">Vencidos: @Model.Kpis.PedidosVencidos</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Sin vencidos</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Producción pendiente</div>
                    <div class="fs-3 fw-bold">@Model.Kpis.ProduccionPendiente</div>
                    <span class="badge bg-secondary">Items sin finalizar</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Inventario faltante (por recetas)</div>
                    <div class="fs-3 fw-bold">@Model.Kpis.InventarioFaltante</div>
                    @if (Model.Kpis.InventarioFaltante > 0)
                    {
                        <span class="badge bg-warning text-dark">Revisar faltantes</span>
                    }
                    else
                    {
                        <span class="badge bg-success">OK</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Compras últimos 30 días</div>
                    <div class="fs-3 fw-bold">@Model.Kpis.ComprasUlt30Dias</div>
                    <div class="text-muted">
                        Gasto: <span class="fw-semibold">$@Model.Kpis.GastoComprasUlt30Dias.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Alertas / Tablas *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold"> Inventario faltante para producción</div>
                    <span class="badge bg-light text-dark">Top 10</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.InventarioFaltante.Any())
                    {
                        <div class="p-3 text-muted">No hay faltantes detectados (según recetas vs producción pendiente).</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Insumo</th>
                                        <th class="text-end">Disponible</th>
                                        <th class="text-end">Requerido</th>
                                        <th class="text-end">Faltante</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var r in Model.InventarioFaltante)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <div class="fw-semibold">@r.InventarioNombre</div>
                                            <div class="text-muted small">@r.UnidadNombre</div>
                                        </td>
                                        <td class="text-end align-middle">@r.Disponible.ToString("N2")</td>
                                        <td class="text-end align-middle">@r.Requerido.ToString("N2")</td>
                                        <td class="text-end align-middle">
                                            <span class="badge bg-warning text-dark">@r.Faltante.ToString("N2")</span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="card-footer text-muted small">
                    Calculado con producción pendiente (InventarioAplicado = 0) × receta.
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold"> Pedidos urgentes</div>
                    <span class="badge bg-light text-dark">≤ 3 días / vencidos</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.PedidosUrgentes.Any())
                    {
                        <div class="p-3 text-muted">No hay pedidos urgentes en el rango configurado.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Pedido</th>
                                        <th>Cliente</th>
                                        <th>Entrega</th>
                                        <th class="text-end">Días</th>
                                        <th>Estatus</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var p in Model.PedidosUrgentes)
                                {
                                    <tr>
                                        <td class="align-middle fw-semibold">#@p.PedidoId</td>
                                        <td class="align-middle">@p.ClienteNombre</td>
                                        <td class="align-middle">@p.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end align-middle">
                                            @if (p.EsVencido)
                                            {
                                                <span class="badge bg-danger">@p.DiasParaEntrega</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@p.DiasParaEntrega</span>
                                            }
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge bg-secondary">@p.EstatusNombre</span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">🛠️ Producción pendiente</div>
                    <span class="badge bg-light text-dark">Top 10</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.ProduccionPendiente.Any())
                    {
                        <div class="p-3 text-muted">No hay producción pendiente.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Item</th>
                                        <th>Pedido</th>
                                        <th>Cliente</th>
                                        <th>Producto</th>
                                        <th class="text-end">Cant.</th>
                                        <th>Estatus</th>
                                        <th>Entrega</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var x in Model.ProduccionPendiente)
                                {
                                    <tr>
                                        <td class="align-middle">#@x.ProduccionItemId</td>
                                        <td class="align-middle fw-semibold">#@x.PedidoId</td>
                                        <td class="align-middle">@x.ClienteNombre</td>
                                        <td class="align-middle">@x.ProductoNombre</td>
                                        <td class="text-end align-middle">@x.Cantidad</td>
                                        <td class="align-middle">
                                            <span class="badge bg-secondary">@x.ProduccionEstatus</span>
                                        </td>
                                        <td class="align-middle">
                                            @if (x.FechaEntregaEstimada is null)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else if (x.DiasParaEntrega < 0)
                                            {
                                                <span class="badge bg-danger">@x.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</span>
                                            }
                                            else if (x.DiasParaEntrega <= 3)
                                            {
                                                <span class="badge bg-warning text-dark">@x.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">@x.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>