@model ReporteCotizacionesSeguimientoViewModel

@{
    ViewData["Title"] = "Cotizaciones - Seguimiento";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);

        --primary: #1D4ED8;
        --success: #16A34A;

        --shadow: 0 10px 30px rgba(2,6,23,.08);
        --radius: 18px;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 1.45rem + 1.25vw, 2.75rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 92ch;
    }

    .card{
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: var(--card-bg);
    }
    .card-header{
        background: transparent;
        border-bottom: 1px solid var(--border);
        padding: .95rem 1.1rem;
        font-weight: 900;
        color: var(--text);
    }
    .card-body{ padding: 1.1rem; }

    .form-label{
        font-weight: 900;
        color: var(--text);
    }
    .form-control, .form-select{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .68rem;
        padding-bottom: .68rem;
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .btn{
        border-radius: 999px;
        font-weight: 850;
        white-space: nowrap;
    }
    .btn-primary{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-success{
        background: rgba(22,163,74,.12);
        border-color: rgba(22,163,74,.22);
        color: #166534;
        font-weight: 900;
    }
    .btn-success:hover{
        background: rgba(22,163,74,.16);
        border-color: rgba(22,163,74,.26);
        color: #14532D;
    }
    .btn-outline-secondary{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-outline-secondary:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn:focus{
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
    }

    .form-check-input{
        border-color: rgba(15,23,42,.22);
    }
    .form-check-input:checked{
        background-color: var(--primary);
        border-color: var(--primary);
    }
    .form-check-label{
        color: var(--text);
        font-weight: 850;
    }

    .table thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        padding-top: .6rem !important;
        padding-bottom: .6rem !important;
    }
    .table tbody td{
        border-top: 1px solid var(--border2);
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
        vertical-align: middle;
        font-size: .95rem;
        color: var(--text);
    }

    a{
        color: color-mix(in srgb, var(--primary) 88%, #000);
        font-weight: 900;
        text-decoration: none;
    }
    a:hover{ text-decoration: underline; }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
            @{
                string fmtDate(DateTime d) => d.ToString("yyyy-MM-dd");
            }

            <div>
                <h1 class="pg-title mb-0">Cotizaciones: conversión y seguimiento</h1>
                <div class="pg-subtitle">Seguimiento por estatus, conversión a pedido y señales de cobranza.</div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-success"
                   asp-controller="Reportes"
                   asp-action="CotizacionesExcel"
                   asp-route-desde="@fmtDate(Model.Desde)"
                   asp-route-hasta="@fmtDate(Model.Hasta)"
                   asp-route-clienteId="@Model.ClienteId"
                   asp-route-cotizacionEstatusId="@Model.CotizacionEstatusId"
                   asp-route-soloConvertidas="@Model.SoloConvertidas"
                   asp-route-soloUltimaPorPedido="@Model.SoloUltimaPorPedido"
                   asp-route-minMonto="@Model.MinMonto"
                   asp-route-q="@Model.Q">
                    Exportar Excel
                </a>

                <a class="btn btn-outline-secondary" href="/Reportes">Volver</a>
            </div>
        </div>

        <form class="card card-body mb-3" method="get">
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Cliente</label>
                    <select class="form-select" name="clienteId">
                        <option value="">-- Todos --</option>
                        @foreach (var c in Model.Clientes)
                        {
                            <option value="@c.Id" selected="@(Model.ClienteId == c.Id)">
                                @c.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estatus cotización</label>
                    <select class="form-select" name="cotizacionEstatusId">
                        <option value="">-- Todos --</option>
                        @foreach (var e in Model.Estatus)
                        {
                            <option value="@e.Id" selected="@(Model.CotizacionEstatusId == e.Id)">
                                @e.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Min monto($)</label>
                    <input class="form-control" name="minMonto" value="@(Model.MinMonto?.ToString() ?? "")" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Buscar</label>
                    <input class="form-control" name="q" value="@(Model.Q ?? "")" placeholder="Cliente, notas, PedidoId, CotizacionId..." />
                </div>

                <div class="col-md-6 d-flex align-items-end gap-3 flex-wrap">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="soloConvertidas" value="true" @(Model.SoloConvertidas ? "checked" : "") />
                        <label class="form-check-label">Solo convertidas</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="soloUltimaPorPedido" value="true" @(Model.SoloUltimaPorPedido ? "checked" : "") />
                        <label class="form-check-label">Solo última por pedido</label>
                    </div>

                    <div class="ms-auto d-flex gap-2 flex-wrap">
                        <button class="btn btn-primary" type="submit">Filtrar</button>
                        <a class="btn btn-outline-secondary" href="/Reportes/Cotizaciones">Limpiar</a>
                    </div>
                </div>
            </div>
        </form>

        <div class="row g-2 mb-3">
            <div class="col-md-2">
                <div class="card card-body">
                    <div class="text-muted small">Cotizaciones</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.Cotizaciones</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card card-body">
                    <div class="text-muted small">Convertidas</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.Convertidas</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card card-body">
                    <div class="text-muted small">Conversión %</div>
                    <div class="fs-4 fw-semibold">@((Model.Totales.ConversionPct ?? 0).ToString("N2"))%</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Monto total</div>
                    <div class="fs-4 fw-semibold">$@((Model.Totales.MontoTotal ?? 0).ToString("N2"))</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Avg días a conversión</div>
                    <div class="fs-4 fw-semibold">@((Model.Totales.AvgDiasAConversion ?? 0).ToString("N1"))</div>
                </div>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <div class="card card-body">
                    <div class="text-muted small">Aceptadas</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.Aceptadas</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-body">
                    <div class="text-muted small">Pendientes</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.Pendientes</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-body">
                    <div class="text-muted small">Rechazadas</div>
                    <div class="fs-4 fw-semibold">@Model.Totales.Rechazadas</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Resumen por estatus</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Estatus</th>
                            <th class="text-end">Cotizaciones</th>
                            <th class="text-end">Monto</th>
                            <th class="text-end">Convertidas</th>
                            <th class="text-end">Conversión %</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.PorEstatus)
                    {
                        <tr>
                            <td>@r.CotizacionEstatusNombre</td>
                            <td class="text-end">@r.Cotizaciones</td>
                            <td class="text-end">$@((r.Monto ?? 0).ToString("N2"))</td>
                            <td class="text-end">@r.Convertidas</td>
                            <td class="text-end">@((r.ConversionPct ?? 0).ToString("N2"))%</td>
                        </tr>
                    }
                    @if (!Model.PorEstatus.Any())
                    {
                        <tr><td colspan="5" class="text-muted text-center py-3">Sin datos</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Detalle</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Cotización</th>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Estatus</th>
                            <th>Categoría</th>
                            <th>Fecha</th>
                            <th class="text-end">Monto</th>
                            <th class="text-end">Pagado</th>
                            <th class="text-end">Saldo</th>
                            <th>Último pago</th>
                            <th>Conv</th>
                            <th class="text-end">Días</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.CotizacionId</td>
                            <td>
                                @r.PedidoId
                                <div class="small">
                                    <a href="/Reportes/Pedido360?pedidoId=@r.PedidoId">Pedido 360</a>
                                </div>
                            </td>
                            <td>@r.ClienteNombre</td>
                            <td>@r.CotizacionEstatusNombre</td>
                            <td>@r.Categoria</td>
                            <td>@r.CotizacionFechaCreacion.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">$@r.MontoCotizacion.ToString("N2")</td>
                            <td class="text-end">$@r.TotalPagado.ToString("N2")</td>
                            <td class="text-end">$@r.Saldo.ToString("N2")</td>
                            <td>
                                @(r.UltimoPagoFecha?.ToString("yyyy-MM-dd") ?? "-")
                                <div class="small text-muted">
                                    @(r.UltimoPagoTipoNombre ?? r.UltimoPagoMetodo ?? "-")
                                </div>
                            </td>
                            <td>@(r.Convertida ? "Sí" : "No")</td>
                            <td class="text-end">@(r.DiasAConversion?.ToString() ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="12" class="text-muted text-center py-3">Sin datos</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>