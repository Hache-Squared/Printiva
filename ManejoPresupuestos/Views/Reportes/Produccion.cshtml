@model ManejoPresupuestos.Models.ReporteProduccionWipViewModel
@{
    ViewData["Title"] = "Producción - WIP";
    string fmtDate(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);

        --primary: #1D4ED8;
        --success: #16A34A;
        --warning: #F59E0B;
        --danger:  #EF4444;

        --shadow: 0 10px 30px rgba(2,6,23,.08);
        --shadow2: 0 16px 44px rgba(2,6,23,.12);
        --radius: 18px;
    }

    body{ background: var(--pg-bg); }

    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 1.45rem + 1.25vw, 2.75rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 92ch;
    }

    .card{
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: var(--card-bg);
    }
    .card-header{
        background: transparent;
        border-bottom: 1px solid var(--border);
        padding: .95rem 1.1rem;
        font-weight: 900;
        color: var(--text);
    }
    .card-body{ padding: 1.1rem; }

    /* Botones */
    .btn{
        border-radius: 999px;
        font-weight: 850;
    }
    .btn-primary{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-outline-secondary{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-outline-secondary:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn-success{
        background: rgba(22,163,74,.12);
        border-color: rgba(22,163,74,.22);
        color: #166534;
        font-weight: 900;
    }
    .btn-success:hover{
        background: rgba(22,163,74,.16);
        border-color: rgba(22,163,74,.26);
        color: #14532D;
    }
    .btn-outline-secondary:focus,
    .btn-primary:focus,
    .btn-success:focus{
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
    }

    /* Inputs */
    .form-label{
        font-weight: 900;
        color: var(--text);
    }
    .form-control, .form-select{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .68rem;
        padding-bottom: .68rem;
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }
    .form-check-label{ color: var(--text); font-weight: 850; }
    .form-check-input{ border-color: rgba(15,23,42,.18); }
    .form-check-input:checked{ background-color: var(--primary); border-color: var(--primary); }

    /* Tablas finas */
    .table thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        padding-top: .6rem !important;
        padding-bottom: .6rem !important;
    }
    .table tbody td{
        border-top: 1px solid var(--border2);
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
        vertical-align: middle;
        font-size: .95rem;
        color: var(--text);
    }

    /* Badges más suaves */
    .badge{
        border-radius: 999px;
        font-weight: 900;
        padding: .34rem .55rem;
        letter-spacing: .01em;
    }
    .badge.bg-secondary{
        background: rgba(100,116,139,.14) !important;
        color: #334155 !important;
        border: 1px solid rgba(100,116,139,.22);
    }
    .badge.bg-warning.text-dark{
        background: rgba(245,158,11,.16) !important;
        border: 1px solid rgba(245,158,11,.22);
        color: #7C2D12 !important;
    }
    .badge.bg-danger{
        background: rgba(239,68,68,.14) !important;
        border: 1px solid rgba(239,68,68,.22);
        color: #991B1B !important;
    }
    .badge.bg-success{
        background: rgba(22,163,74,.14) !important;
        border: 1px solid rgba(22,163,74,.22);
        color: #166534 !important;
    }

    /* KPI cards compactas */
    .kpi-card{
        padding: 1.05rem 1.1rem;
    }
    .kpi-val{
        font-weight: 950;
        letter-spacing: -.02em;
        color: var(--text);
    }

    /* Resalta filas atrasadas sin el amarillo fuerte de bootstrap */
    .table-warning{
        --bs-table-bg: rgba(245,158,11,.10);
        --bs-table-striped-bg: rgba(245,158,11,.08);
        --bs-table-hover-bg: rgba(245,158,11,.12);
    }

    /* Links dentro de tablas */
    .table a{
        color: color-mix(in srgb, var(--primary) 88%, #000);
        font-weight: 900;
        text-decoration: none;
    }
    .table a:hover{
        text-decoration: underline;
    }

    /* Layout */
    .top-meta{
        color: var(--muted);
        font-size: .9rem;
        font-weight: 800;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h1 class="pg-title mb-1">Producción (WIP + Carga)</h1>
                <div class="pg-subtitle">Tablero operativo: WIP por etapa, carga por impresora y antigüedad en cola</div>
            </div>
            <a class="btn btn-outline-secondary" href="/Reportes">Volver</a>
        </div>

        <!-- Filtros -->
        <form method="get" class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Desde</label>
                        <input type="date" name="desde" class="form-control" value="@fmtDate(Model.Desde)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Hasta</label>
                        <input type="date" name="hasta" class="form-control" value="@fmtDate(Model.Hasta)" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Cliente</label>
                        <select class="form-select" name="clienteId">
                            <option value="">-- Todos --</option>
                            @foreach (var c in Model.CatClientes)
                            {
                                <option value="@c.Id" selected="@(Model.ClienteId == c.Id)">
                                    @c.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">PedidoId</label>
                        <input type="number" name="pedidoId" class="form-control" value="@(Model.PedidoId?.ToString() ?? "")" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Estatus producción</label>
                        <select class="form-select" name="estatusId">
                            <option value="">-- Todos --</option>
                            @foreach (var e in Model.CatEstatus.OrderBy(x => x.Orden))
                            {
                                <option value="@e.Id" selected="@(Model.EstatusId == e.Id)">
                                    @e.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Impresora</label>
                        <select class="form-select" name="impresoraId">
                            <option value="">-- Todas --</option>
                            @foreach (var i in Model.CatImpresoras.OrderBy(x => x.Nombre))
                            {
                                <option value="@i.Id" selected="@(Model.ImpresoraId == i.Id)">
                                    @i.Nombre @(!string.IsNullOrWhiteSpace(i.Modelo) ? $"({i.Modelo})" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Mín días en cola</label>
                        <input type="number" name="minDiasCola" class="form-control" value="@(Model.MinDiasCola?.ToString() ?? "")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Buscar (cliente/producto/nota)</label>
                        <input type="text" name="q" class="form-control" value="@(Model.Q ?? "")" placeholder="Ej: goku, llavero, ana..." />
                    </div>

                    <div class="col-md-6 d-flex gap-3 align-items-center flex-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="soloWip" value="true" @(Model.SoloWip ? "checked" : "") />
                            <input type="hidden" name="soloWip" value="false" />
                            <label class="form-check-label">Solo WIP</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="soloAtrasados" value="true" @(Model.SoloAtrasados ? "checked" : "") />
                            <input type="hidden" name="soloAtrasados" value="false" />
                            <label class="form-check-label">Solo atrasados</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="sinImpresora" value="true" @(Model.SinImpresora ? "checked" : "") />
                            <input type="hidden" name="sinImpresora" value="false" />
                            <label class="form-check-label">Sin impresora</label>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex gap-2 justify-content-end flex-wrap">
                        <button class="btn btn-primary" type="submit">Filtrar</button>
                        <a class="btn btn-success"
                           asp-action="ExportarProduccionExcel"
                           asp-route-desde="@fmtDate(Model.Desde)"
                           asp-route-hasta="@fmtDate(Model.Hasta)"
                           asp-route-clienteId="@Model.ClienteId"
                           asp-route-pedidoId="@Model.PedidoId"
                           asp-route-estatusId="@Model.EstatusId"
                           asp-route-impresoraId="@Model.ImpresoraId"
                           asp-route-soloWip="@Model.SoloWip"
                           asp-route-soloAtrasados="@Model.SoloAtrasados"
                           asp-route-sinImpresora="@Model.SinImpresora"
                           asp-route-minDiasCola="@Model.MinDiasCola"
                           asp-route-q="@Model.Q">
                            Exportar Excel
                        </a>
                        <a class="btn btn-outline-secondary" href="/Reportes/Produccion">Limpiar</a>
                    </div>
                </div>
            </div>
        </form>

        <!-- KPIs -->
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="text-muted small">Items</div>
                    <div class="fs-4 kpi-val">@Model.Totales.Items</div>
                    <div class="text-muted small">Cantidad total: @Model.Totales.CantidadTotal</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="text-muted small">WIP</div>
                    <div class="fs-4 kpi-val">@Model.Totales.WipItems</div>
                    <div class="text-muted small">Finalizados: @Model.Totales.FinalizadosItems</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="text-muted small">Atrasados</div>
                    <div class="fs-4 kpi-val">@Model.Totales.Atrasados</div>
                    <div class="text-muted small">Sin impresora: @Model.Totales.SinImpresora</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="text-muted small">Antigüedad (prom / max)</div>
                    <div class="fs-4 kpi-val">@Model.Totales.AvgDiasEnEstatus.ToString("0.0") / @Model.Totales.MaxDiasEnEstatus</div>
                    <div class="text-muted small">días en estatus actual</div>
                </div>
            </div>
        </div>

        <!-- Agregados -->
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header fw-semibold">WIP por estatus</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Estatus</th>
                                    <th class="text-end">Items</th>
                                    <th class="text-end">Cant.</th>
                                    <th class="text-end">Atrasados</th>
                                    <th class="text-end">Avg días</th>
                                    <th class="text-end">Max</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.WipPorEstatus.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">Sin datos</td></tr>
                            }
                            else
                            {
                                @foreach (var x in Model.WipPorEstatus.OrderBy(x => x.ProduccionEstatusOrden))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(string.IsNullOrWhiteSpace(x.BadgeClass) ? "bg-secondary" : x.BadgeClass)">@x.ProduccionEstatusNombre</span>
                                        </td>
                                        <td class="text-end">@x.Items</td>
                                        <td class="text-end">@x.Cantidad</td>
                                        <td class="text-end">@x.Atrasados</td>
                                        <td class="text-end">@x.AvgDiasEnEstatus.ToString("0.0")</td>
                                        <td class="text-end">@x.MaxDiasEnEstatus</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header fw-semibold">Carga por impresora</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Impresora</th>
                                    <th class="text-end">Items</th>
                                    <th class="text-end">WIP</th>
                                    <th class="text-end">Atrasados</th>
                                    <th class="text-end">Avg días</th>
                                    <th class="text-end">Max</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.PorImpresora.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">Sin datos</td></tr>
                            }
                            else
                            {
                                @foreach (var x in Model.PorImpresora.OrderByDescending(x => x.WipItems).ThenByDescending(x => x.Items))
                                {
                                    <tr>
                                        <td>
                                            @if (x.ImpresoraId.HasValue)
                                            {
                                                <span>@x.ImpresoraNombre @(!string.IsNullOrWhiteSpace(x.ImpresoraModelo) ? $"({x.ImpresoraModelo})" : "")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">(Sin impresora)</span>
                                            }
                                        </td>
                                        <td class="text-end">@x.Items</td>
                                        <td class="text-end">@x.WipItems</td>
                                        <td class="text-end">@x.Atrasados</td>
                                        <td class="text-end">@x.AvgDiasEnEstatus.ToString("0.0")</td>
                                        <td class="text-end">@x.MaxDiasEnEstatus</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Antigüedad -->
        <div class="card mb-3">
            <div class="card-header fw-semibold">Pendientes por antigüedad (en fila)</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Bucket</th>
                            <th class="text-end">Items</th>
                            <th class="text-end">Cant.</th>
                            <th class="text-end">Atrasados</th>
                            <th class="text-end">Avg días</th>
                            <th class="text-end">Max</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.PorAntiguedad.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Sin datos</td></tr>
                    }
                    else
                    {
                        @foreach (var x in Model.PorAntiguedad.OrderBy(x => x.ColaBucketId))
                        {
                            <tr>
                                <td>@x.ColaBucketNombre</td>
                                <td class="text-end">@x.Items</td>
                                <td class="text-end">@x.Cantidad</td>
                                <td class="text-end">@x.Atrasados</td>
                                <td class="text-end">@x.AvgDiasEnEstatus.ToString("0.0")</td>
                                <td class="text-end">@x.MaxDiasEnEstatus</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Detalle -->
        <div class="card">
            <div class="card-header fw-semibold">Detalle</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>ProdItem</th>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Producto</th>
                            <th class="text-end">Cant.</th>
                            <th>Estatus</th>
                            <th>Impresora</th>
                            <th class="text-end">Días</th>
                            <th>En estatus</th>
                            <th>Entrega est.</th>
                            <th>Atraso</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Detalle.Count == 0)
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">Sin datos</td></tr>
                    }
                    else
                    {
                        @foreach (var x in Model.Detalle)
                        {
                            <tr class="@(x.Atrasado ? "table-warning" : "")">
                                <td>@x.ProduccionItemId</td>
                                <td>
                                    <a href="/Reportes/Pedido360?pedidoId=@x.PedidoId">#@x.PedidoId</a>
                                </td>
                                <td>@x.ClienteNombre</td>
                                <td>@x.ProductoNombre</td>
                                <td class="text-end">@x.Cantidad</td>
                                <td>
                                    <span class="badge @(string.IsNullOrWhiteSpace(x.BadgeClass) ? "bg-secondary" : x.BadgeClass)">
                                        @x.ProduccionEstatusNombre
                                    </span>
                                    <div class="text-muted small">@x.ColaBucketNombre</div>
                                </td>
                                <td>
                                    @if (x.ImpresoraId.HasValue)
                                    {
                                        <span>@x.ImpresoraNombre</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">(Sin impresora)</span>
                                    }
                                </td>
                                <td class="text-end">@x.DiasEnEstatus</td>
                                <td>@x.FechaEnEstatus.ToString("yyyy-MM-dd")</td>
                                <td>@(x.FechaEntregaEstimada.HasValue ? x.FechaEntregaEstimada.Value.ToString("yyyy-MM-dd") : "-")</td>
                                <td>@(x.Atrasado ? "Sí" : "No")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>