@model ManejoPresupuestos.Models.ReportePedido360ViewModel
@using System.Linq

@{
    ViewData["Title"] = "Pedido 360";
    var header = Model.Header;

    var cotHeader = Model.Cotizacion.FirstOrDefault(x => x.RowType == "HEADER");
    var cotItems = Model.Cotizacion.Where(x => x.RowType == "ITEM").ToList();

    var totalCot = cotItems.Sum(x => x.Subtotal ?? 0m);
    var totalPagado = Model.Pagos.Where(p => p.EstaActivo).Sum(p => p.Monto);
    var pendiente = totalCot - totalPagado;
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);

        --primary: #1D4ED8;
        --success: #16A34A;
        --warning: #F59E0B;
        --danger:  #EF4444;

        --shadow: 0 10px 30px rgba(2,6,23,.08);
        --radius: 18px;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 1.45rem + 1.25vw, 2.75rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 92ch;
    }

    /* Cards */
    .card{
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: var(--card-bg);
    }
    .card-header{
        background: transparent;
        border-bottom: 1px solid var(--border);
        padding: .95rem 1.1rem;
        font-weight: 900;
        color: var(--text);
    }
    .card-body{ padding: 1.1rem; }

    /* Form */
    .form-label{
        font-weight: 900;
        color: var(--text);
    }
    .form-control, .form-select{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .68rem;
        padding-bottom: .68rem;
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    /* Buttons */
    .btn{
        border-radius: 999px;
        font-weight: 850;
    }
    .btn-primary{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-outline-secondary{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-outline-secondary:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn-success{
        background: rgba(22,163,74,.12);
        border-color: rgba(22,163,74,.22);
        color: #166534;
        font-weight: 900;
    }
    .btn-success:hover{
        background: rgba(22,163,74,.16);
        border-color: rgba(22,163,74,.26);
        color: #14532D;
    }
    .btn:focus{
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
    }

    /* Alerts */
    .alert{
        border-radius: 16px;
        border-color: rgba(245,158,11,.22);
        background: rgba(245,158,11,.10);
        color: var(--text);
        box-shadow: var(--shadow);
    }

    /* Tables: compact + clean */
    .table thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        padding-top: .6rem !important;
        padding-bottom: .6rem !important;
    }
    .table tbody td{
        border-top: 1px solid var(--border2);
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
        vertical-align: middle;
        font-size: .95rem;
        color: var(--text);
    }

    /* Badges: softer */
    .badge{
        border-radius: 999px;
        font-weight: 900;
        padding: .34rem .55rem;
        letter-spacing: .01em;
    }
    .badge.bg-secondary{
        background: rgba(100,116,139,.14) !important;
        color: #334155 !important;
        border: 1px solid rgba(100,116,139,.22);
    }
    .badge.bg-warning.text-dark{
        background: rgba(245,158,11,.16) !important;
        border: 1px solid rgba(245,158,11,.22);
        color: #7C2D12 !important;
    }
    .badge.bg-danger{
        background: rgba(239,68,68,.14) !important;
        border: 1px solid rgba(239,68,68,.22);
        color: #991B1B !important;
    }
    .badge.bg-success{
        background: rgba(22,163,74,.14) !important;
        border: 1px solid rgba(22,163,74,.22);
        color: #166534 !important;
    }
    .badge.bg-dark{
        background: rgba(15,23,42,.90) !important;
        border: 1px solid rgba(15,23,42,.18);
    }
    .badge.bg-light.text-dark{
        background: rgba(15,23,42,.03) !important;
        border: 1px solid rgba(15,23,42,.10);
        color: var(--text) !important;
    }

    /* Highlight rows */
    .table-warning{
        --bs-table-bg: rgba(245,158,11,.10);
        --bs-table-striped-bg: rgba(245,158,11,.08);
        --bs-table-hover-bg: rgba(245,158,11,.12);
    }

    /* Links */
    a{
        color: color-mix(in srgb, var(--primary) 88%, #000);
        font-weight: 900;
        text-decoration: none;
    }
    a:hover{ text-decoration: underline; }

    /* Mini KPI cards in header area */
    .kpi-card{
        padding: 1.05rem 1.1rem;
    }
    .kpi-val{
        font-weight: 950;
        letter-spacing: -.02em;
        color: var(--text);
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h1 class="pg-title mb-0">Pedido 360</h1>
                <div class="pg-subtitle">Vista integral: pedido, cotización, pagos, producción, consumo y timeline.</div>
            </div>
            <a class="btn btn-outline-secondary" href="/Reportes">Volver</a>
        </div>

        <form class="card card-body mb-3" method="get">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">PedidoId</label>
                    <input class="form-control" name="pedidoId" value="@(Model.PedidoId == 0 ? "" : Model.PedidoId.ToString())" />
                </div>
                <div class="col-md-3 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit">Buscar</button>
                    @if (Model.Header is not null)
                    {
                        <a class="btn btn-success"
                           asp-action="ExportarPedido360Excel"
                           asp-route-pedidoId="@Model.PedidoId">
                            Exportar Excel
                        </a>
                        <a class="btn btn-outline-secondary"
                           asp-controller="Pedidos"
                           asp-action="Detalles"
                           asp-route-id="@Model.PedidoId">
                            Acciones
                        </a>
                    }
                    <a class="btn btn-outline-secondary" href="/Reportes/Pedido360">Limpiar</a>
                </div>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
        {
            <div class="alert alert-warning">@Model.Mensaje</div>
        }

        @if (header is not null)
        {
            <!-- HEADER -->
            <div class="row g-2 mb-3">
                <div class="col-md-8">
                    <div class="card card-body">
                        <div class="d-flex justify-content-between flex-wrap gap-3">
                            <div>
                                <div class="text-muted small">Cliente</div>
                                <div class="fs-5 fw-semibold">@header.ClienteNombre</div>
                                <div class="small text-muted">
                                    @(header.Telefono ?? "-") · @(header.WhatsApp ?? "-") · @(header.Instagram ?? "-")
                                </div>
                                <div class="small text-muted">
                                    @(header.Email ?? "-") · @(header.Direccion ?? "-")
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small">Estatus pedido</div>
                                <div class="fw-semibold">@header.PedidoEstatusNombre</div>
                                <div class="text-muted small mt-2">PedidoId</div>
                                <div class="fw-semibold">@header.PedidoId</div>
                            </div>
                        </div>

                        <hr />

                        <div class="row g-2">
                            <div class="col-md-3">
                                <div class="text-muted small">Creación</div>
                                <div class="fw-semibold">@header.FechaCreacion.ToString("dd-MM-yyyy HH:mm")</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Entrega estimada</div>
                                <div class="fw-semibold">@(header.FechaEntregaEstimada?.ToString("dd-MM-yyyy") ?? "-")</div>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted small">Notas</div>
                                <div>@(string.IsNullOrWhiteSpace(header.Notas) ? "-" : header.Notas)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="row g-2">
                        <div class="col-12">
                            <div class="card kpi-card">
                                <div class="text-muted small">Total estimado</div>
                                <div class="fs-4 kpi-val">$@((header.TotalEstimado ?? 0m).ToString("N2"))</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="card kpi-card">
                                <div class="text-muted small">Total cotización</div>
                                <div class="fs-4 kpi-val">$@totalCot.ToString("N2")</div>
                                <div class="text-muted small mt-2">Pagado</div>
                                <div class="fw-semibold">$@totalPagado.ToString("N2")</div>
                                <div class="text-muted small">Pendiente</div>
                                <div class="fw-semibold">$@pendiente.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2) ITEMS DEL PEDIDO -->
            <div class="card mb-3">
                <div class="card-header fw-semibold">Items del pedido</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>PedidoItemId</th>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Precio Est.</th>
                                <th class="text-end">ProdItems</th>
                                <th class="text-end">Cant. Prod</th>
                                <th class="text-end">Peso Est.</th>
                                <th class="text-end">Peso Real</th>
                                <th>Notas</th>
                                <th>Activo</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in Model.Items.OrderBy(x => x.PedidoItemId))
                        {
                            <tr>
                                <td>@i.PedidoItemId</td>
                                <td>@(i.ProductoNombre ?? i.ProductoId.ToString())</td>
                                <td>@(i.ProductoCategoriaNombre ?? "-")</td>
                                <td class="text-end">@i.Cantidad</td>
                                <td class="text-end">$@((i.PrecioUnitarioEstimado ?? 0m).ToString("N2"))</td>
                                <td class="text-end">@i.ProduccionItems</td>
                                <td class="text-end">@i.CantidadEnProduccion</td>
                                <td class="text-end">@i.PesoEstimadoGrTotal.ToString("N2")</td>
                                <td class="text-end">@i.PesoRealGrTotal.ToString("N2")</td>
                                <td>@(i.Notas ?? "-")</td>
                                <td>@(i.EstaActivo ? "Sí" : "No")</td>
                            </tr>
                        }
                        @if (!Model.Items.Any())
                        {
                            <tr><td colspan="11" class="text-muted text-center py-3">Sin items</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3) COTIZACIÓN (HEADER + ITEMS) -->
            <div class="card mb-3">
                <div class="card-header fw-semibold">Cotización vinculada</div>

                @if (cotHeader is null && !cotItems.Any())
                {
                    <div class="card-body text-muted">Sin cotización vinculada.</div>
                }
                else
                {
                    <div class="card-body">
                        @if (cotHeader is not null)
                        {
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <div class="text-muted small">CotizaciónId</div>
                                    <div class="fw-semibold">@cotHeader.CotizacionId</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">Estatus</div>
                                    <div class="fw-semibold">@cotHeader.CotizacionEstatusNombre</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">Creación</div>
                                    <div class="fw-semibold">@cotHeader.FechaCreacion.ToString("dd-MM-yyyy")</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">Vigencia</div>
                                    <div class="fw-semibold">@(cotHeader.FechaVigencia?.ToString("dd-MM-yyyy") ?? "-")</div>
                                </div>
                                <div class="col-12 mt-2">
                                    <div class="text-muted small">Notas</div>
                                    <div>@(string.IsNullOrWhiteSpace(cotHeader.Notas) ? "-" : cotHeader.Notas)</div>
                                </div>
                            </div>
                            <hr />
                        }

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ItemId</th>
                                        <th>Tipo</th>
                                        <th>Concepto</th>
                                        <th>Producto</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">P.U.</th>
                                        <th class="text-end">Subtotal</th>
                                        <th>Notas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var ci in cotItems.OrderBy(x => x.CotizacionItemId))
                                {
                                    <tr>
                                        <td>@(ci.CotizacionItemId?.ToString() ?? "-")</td>
                                        <td>@(ci.ConceptoTipoNombre ?? ci.ConceptoTipoId?.ToString() ?? "-")</td>
                                        <td>@(ci.Concepto ?? "-")</td>
                                        <td>@(ci.ProductoNombre ?? "-")</td>
                                        <td class="text-end">@((ci.Cantidad ?? 0m).ToString("N2"))</td>
                                        <td class="text-end">$@((ci.PrecioUnitario ?? 0m).ToString("N2"))</td>
                                        <td class="text-end">$@((ci.Subtotal ?? 0m).ToString("N2"))</td>
                                        <td>@(ci.ItemNotas ?? "-")</td>
                                    </tr>
                                }
                                @if (!cotItems.Any())
                                {
                                    <tr><td colspan="8" class="text-muted text-center py-3">Sin items en cotización</td></tr>
                                }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="6" class="text-end fw-semibold">Total</td>
                                        <td class="text-end fw-semibold">$@totalCot.ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <!-- 4) PAGOS -->
            <div class="card mb-3">
                <div class="card-header fw-semibold">Pagos</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>PagoId</th>
                                <th>Tipo</th>
                                <th>Fecha</th>
                                <th>Método</th>
                                <th>Referencia</th>
                                <th>Notas</th>
                                <th class="text-end">Monto</th>
                                <th>Activo</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in Model.Pagos.OrderByDescending(x => x.FechaPago))
                        {
                            <tr>
                                <td>@p.PagoId</td>
                                <td>@(p.PagoTipoNombre ?? p.PagoTipoId.ToString())</td>
                                <td>@p.FechaPago.ToString("dd-MM-yyyy")</td>
                                <td>@(p.Metodo ?? "-")</td>
                                <td>@(p.Referencia ?? "-")</td>
                                <td>@(p.Notas ?? "-")</td>
                                <td class="text-end">$@p.Monto.ToString("N2")</td>
                                <td>@(p.EstaActivo ? "Sí" : "No")</td>
                            </tr>
                        }
                        @if (!Model.Pagos.Any())
                        {
                            <tr><td colspan="8" class="text-muted text-center py-3">Sin pagos</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 5) PRODUCCIÓN -->
            <div class="card mb-3">
                <div class="card-header fw-semibold">Producción</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ProdItemId</th>
                                <th>PedidoItemId</th>
                                <th>Producto</th>
                                <th class="text-end">Cantidad</th>
                                <th>Estatus</th>
                                <th>Impresora</th>
                                <th>Receta</th>
                                <th class="text-end">Peso Est.</th>
                                <th class="text-end">Peso Real</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Inventario aplicado</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var pr in Model.Produccion.OrderBy(x => x.ProduccionEstatusOrden).ThenBy(x => x.ProduccionItemId))
                        {
                            <tr>
                                <td>@pr.ProduccionItemId</td>
                                <td>@pr.PedidoItemId</td>
                                <td>@pr.ProductoNombre</td>
                                <td class="text-end">@pr.Cantidad</td>
                                <td>@pr.ProduccionEstatusNombre</td>
                                <td>@(pr.ImpresoraNombre ?? "-")</td>
                                <td>@(pr.RecetaNombre ?? "-")</td>
                                <td class="text-end">@((pr.PesoEstimadoGr ?? 0m).ToString("N2"))</td>
                                <td class="text-end">@((pr.PesoRealGr ?? 0m).ToString("N2"))</td>
                                <td>@(pr.FechaInicio?.ToString("dd-MM-yyyy HH:mm") ?? "-")</td>
                                <td>@(pr.FechaFin?.ToString("dd-MM-yyyy HH:mm") ?? "-")</td>
                                <td>@(pr.InventarioAplicado ? "Sí" : "No")</td>
                            </tr>
                        }
                        @if (!Model.Produccion.Any())
                        {
                            <tr><td colspan="12" class="text-muted text-center py-3">Sin producción</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 6) CONSUMO -->
            <div class="card mb-3">
                <div class="card-header fw-semibold">Consumo de inventario (por receta/insumo)</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>ProdItem</th>
                                <th>PedidoItem</th>
                                <th>Receta</th>
                                <th>Inventario</th>
                                <th>Unidad</th>
                                <th class="text-end">Planeado</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Antes</th>
                                <th class="text-end">Después</th>
                                <th>Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var c in Model.Consumo.OrderByDescending(x => x.Fecha))
                        {
                            <tr>
                                <td>@c.Fecha.ToString("dd-MM-yyyy HH:mm")</td>
                                <td>@c.ProduccionItemId</td>
                                <td>@(c.PedidoItemId?.ToString() ?? "-")</td>
                                <td>@(c.RecetaNombre ?? c.RecetaId?.ToString() ?? "-")</td>
                                <td>@(c.InsumoNombre ?? c.InventarioId.ToString())</td>
                                <td>@(c.UnidadNombre ?? "-")</td>
                                <td class="text-end">@((c.CantidadPlaneadaTotal ?? 0m).ToString("N2"))</td>
                                <td class="text-end">@c.CantidadConsumida.ToString("N2")</td>
                                <td class="text-end">@((c.DisponibleAntes ?? 0m).ToString("N2"))</td>
                                <td class="text-end">@((c.DisponibleDespues ?? 0m).ToString("N2"))</td>
                                <td>@(c.Notas ?? "-")</td>
                            </tr>
                        }
                        @if (!Model.Consumo.Any())
                        {
                            <tr><td colspan="11" class="text-muted text-center py-3">Sin consumo</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 7) TIMELINE -->
            <div class="card">
                <div class="card-header fw-semibold">Timeline</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>PedidoItem</th>
                                <th>ProdItem</th>
                                <th>Desde</th>
                                <th>Hacia</th>
                                <th>Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var h in Model.Historia)
                        {
                            <tr>
                                <td>@h.Fecha.ToString("dd-MM-yyyy HH:mm")</td>
                                <td>@h.Tipo</td>
                                <td>@(h.PedidoItemId?.ToString() ?? "-")</td>
                                <td>@(h.ProduccionItemId?.ToString() ?? "-")</td>
                                <td>@(h.DesdeEstatusNombre ?? h.DesdeEstatusId.ToString())</td>
                                <td>@(h.HaciaEstatusNombre ?? h.HaciaEstatusId.ToString())</td>
                                <td>@(h.Notas ?? "-")</td>
                            </tr>
                        }
                        @if (!Model.Historia.Any())
                        {
                            <tr><td colspan="7" class="text-muted text-center py-3">Sin movimientos</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>