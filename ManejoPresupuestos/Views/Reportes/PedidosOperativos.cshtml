@model ManejoPresupuestos.Models.ReportePedidosOperativosViewModel
@using System.Linq

@{
    ViewData["Title"] = "Pedidos operativos";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);

        --primary: #1D4ED8;
        --success: #16A34A;
        --warning: #F59E0B;

        --shadow: 0 10px 30px rgba(2,6,23,.08);
        --radius: 18px;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 950;
        letter-spacing: -.03em;
        font-size: clamp(2rem, 1.45rem + 1.25vw, 2.75rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .55rem;
        font-size: .98rem;
        max-width: 92ch;
    }

    .card{
        border-color: var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        background: var(--card-bg);
    }
    .card-header{
        background: transparent;
        border-bottom: 1px solid var(--border);
        padding: .95rem 1.1rem;
        font-weight: 900;
        color: var(--text);
    }
    .card-body{ padding: 1.1rem; }

    .form-label{
        font-weight: 900;
        color: var(--text);
    }
    .form-control, .form-select{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .68rem;
        padding-bottom: .68rem;
    }
    .form-control:focus, .form-select:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .btn{
        border-radius: 999px;
        font-weight: 850;
    }
    .btn-primary{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-success{
        background: rgba(22,163,74,.12);
        border-color: rgba(22,163,74,.22);
        color: #166534;
        font-weight: 900;
    }
    .btn-success:hover{
        background: rgba(22,163,74,.16);
        border-color: rgba(22,163,74,.26);
        color: #14532D;
    }
    .btn-outline-secondary{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-outline-secondary:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn:focus{
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
    }

    .form-check-input{
        border-color: rgba(15,23,42,.22);
    }
    .form-check-input:checked{
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .table thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        padding-top: .6rem !important;
        padding-bottom: .6rem !important;
    }
    .table tbody td{
        border-top: 1px solid var(--border2);
        padding-top: .55rem !important;
        padding-bottom: .55rem !important;
        vertical-align: middle;
        font-size: .95rem;
        color: var(--text);
    }

    .badge{
        border-radius: 999px;
        font-weight: 900;
        padding: .34rem .55rem;
        letter-spacing: .01em;
    }
    .badge.bg-secondary{
        background: rgba(100,116,139,.14) !important;
        color: #334155 !important;
        border: 1px solid rgba(100,116,139,.22);
    }
    .badge.bg-warning.text-dark{
        background: rgba(245,158,11,.16) !important;
        border: 1px solid rgba(245,158,11,.22);
        color: #7C2D12 !important;
    }
    .badge.bg-danger{
        background: rgba(239,68,68,.14) !important;
        border: 1px solid rgba(239,68,68,.22);
        color: #991B1B !important;
    }
    .badge.bg-success{
        background: rgba(22,163,74,.14) !important;
        border: 1px solid rgba(22,163,74,.22);
        color: #166534 !important;
    }
    .badge.bg-light.text-dark{
        background: rgba(15,23,42,.03) !important;
        border: 1px solid rgba(15,23,42,.10);
        color: var(--text) !important;
    }

    .table-warning{
        --bs-table-bg: rgba(245,158,11,.10);
        --bs-table-striped-bg: rgba(245,158,11,.08);
        --bs-table-hover-bg: rgba(245,158,11,.12);
    }

    a{
        color: color-mix(in srgb, var(--primary) 88%, #000);
        font-weight: 900;
        text-decoration: none;
    }
    a:hover{ text-decoration: underline; }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <h1 class="pg-title mb-0">Pedidos operativos</h1>
                <div class="pg-subtitle">Tablero diario para priorizar entrega, saldo y estatus de producción.</div>
            </div>
            <a class="btn btn-outline-secondary" href="/Reportes">Volver</a>
        </div>

        <form class="card card-body mb-3" method="get">
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" name="desde" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" name="hasta" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estatus pedido</label>
                    <select class="form-select" name="pedidoEstatusId">
                        <option value="">-- Todos --</option>
                        @foreach (var e in Model.EstatusPedido)
                        {
                            <option value="@e.Id" selected="@(Model.PedidoEstatusId == e.Id)">
                                @e.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Cliente</label>
                    <select class="form-select" name="clienteId">
                        <option value="">-- Todos --</option>
                        @foreach (var c in Model.Clientes)
                        {
                            <option value="@c.Id" selected="@(Model.ClienteId == c.Id)">
                                @c.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Estatus producción</label>
                    <select class="form-select" name="produccionEstatusId">
                        <option value="">-- Todos --</option>
                        @foreach (var e in Model.EstatusProduccion)
                        {
                            <option value="@e.Id" selected="@(Model.ProduccionEstatusId == e.Id)">
                                @e.Nombre
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Canal (texto)</label>
                    <input class="form-control" name="canal" value="@(Model.Canal ?? "")" placeholder="Ej: Owala, General, Instagram..." />
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="atrasados" value="true" id="chkAtrasados"
                               checked="@(Model.SoloAtrasados)" />
                        <label class="form-check-label" for="chkAtrasados">
                            Solo atrasados
                        </label>
                    </div>
                </div>

                <div class="col-md-5 d-flex justify-content-end gap-2 align-items-end flex-wrap">
                    <button class="btn btn-primary" type="submit">Filtrar</button>
                    @{
                        string fmtDate(DateTime d) => d.ToString("yyyy-MM-dd");
                    }

                    <a class="btn btn-success"
                       asp-controller="Reportes"
                       asp-action="PedidosOperativosExcel"
                       asp-route-desde="@fmtDate(Model.Desde)"
                       asp-route-hasta="@fmtDate(Model.Hasta)"
                       asp-route-pedidoEstatusId="@Model.PedidoEstatusId"
                       asp-route-clienteId="@Model.ClienteId"
                       asp-route-produccionEstatusId="@Model.ProduccionEstatusId"
                       asp-route-canal="@Model.Canal"
                       asp-route-atrasados="@Model.SoloAtrasados">
                        Exportar Excel
                    </a>
                    <a class="btn btn-outline-secondary" href="/Reportes/PedidosOperativos">Limpiar</a>
                </div>
            </div>
        </form>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Pedidos</div>
                    <div class="fs-4 fw-semibold">@Model.TotalPedidos</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Atrasados</div>
                    <div class="fs-4 fw-semibold">@Model.TotalAtrasados</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Saldo total</div>
                    <div class="fs-4 fw-semibold">@Model.TotalSaldo.ToString("N2")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-body">
                    <div class="text-muted small">Rango</div>
                    <div class="fs-6 fw-semibold">@Model.Desde.ToString("yyyy-MM-dd") → @Model.Hasta.ToString("yyyy-MM-dd")</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Tablero diario</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Prioridad</th>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Pagado %</th>
                            <th class="text-end">Saldo</th>
                            <th>Estatus pedido</th>
                            <th>Estatus producción</th>
                            <th>Fecha estimada</th>
                            <th>Atraso</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr class="@(r.EsAtrasado ? "table-warning" : "")">
                            <td class="fw-semibold">@r.Prioridad</td>
                            <td>@r.PedidoId</td>
                            <td>@r.ClienteNombre</td>
                            <td class="text-end">@r.Total.ToString("N2")</td>
                            <td class="text-end">@r.PagadoPorcentaje.ToString("N2")%</td>
                            <td class="text-end">@r.Saldo.ToString("N2")</td>
                            <td>@r.PedidoEstatusNombre</td>
                            <td>@(r.ProduccionEstatusNombre ?? "Sin producción")</td>
                            <td>@(r.FechaEntregaEstimada?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                @(r.EsAtrasado ? $"Sí ({r.DiasAtraso}d)" : "No")
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="/Reportes/Pedido360?pedidoId=@r.PedidoId">
                                    Ver 360
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="11" class="text-muted text-center py-3">Sin datos</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>