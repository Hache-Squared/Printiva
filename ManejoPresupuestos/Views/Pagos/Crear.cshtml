@model ManejoPresupuestos.Models.PagoEdicionViewModel
@{
    ViewData["Title"] = "Registrar pago";
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 980px; }

    .pg-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
        font-size: clamp(1.9rem, 1.35rem + 1.05vw, 2.45rem);
        line-height: 1.08;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        margin-top: .45rem;
        font-size: .98rem;
        max-width: 90ch;
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .btn-pill{
        border-radius: 999px;
        padding: .58rem 1.02rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }

    .control-soft{
        border-radius: 12px;
        border-color: rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        padding-top: .72rem;
        padding-bottom: .72rem;
    }
    .control-soft:focus{
        border-color: rgba(29,78,216,.40);
        box-shadow: 0 0 0 .25rem rgba(29,78,216,.12);
        background: #fff;
    }

    .form-label{
        font-weight: 850;
        color: var(--text);
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Registrar pago</h1>
                <div class="pg-subtitle">Asigna el pago a Modelado/Producción/General.</div>
            </div>
            <a asp-action="Index" asp-route-cotizacionId="@Model.CotizacionId" class="btn btn-pill btn-soft">Volver</a>
        </div>

        <div class="card card-soft">
            <div class="card-body p-4">
                <form asp-action="Crear" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="CotizacionId" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="PagoTipoId" class="form-label"></label>
                            <select asp-for="PagoTipoId" asp-items="@Model.Tipos" class="form-select control-soft"></select>
                            <span asp-validation-for="PagoTipoId" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Monto" class="form-label"></label>
                            <input asp-for="Monto" class="form-control control-soft" />
                            <span asp-validation-for="Monto" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FechaPago" class="form-label"></label>
                            <input asp-for="FechaPago" class="form-control control-soft" />
                            <span asp-validation-for="FechaPago" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Metodo" class="form-label"></label>
                            <input asp-for="Metodo" class="form-control control-soft" placeholder="Efectivo, transferencia, etc." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Referencia" class="form-label"></label>
                            <input asp-for="Referencia" class="form-control control-soft" placeholder="Folio/Referencia" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Notas" class="form-label"></label>
                            <textarea asp-for="Notas" class="form-control control-soft" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button class="btn btn-primary btn-pill btn-primary-pill" type="submit">Guardar</button>
                        <a asp-action="Index" asp-route-cotizacionId="@Model.CotizacionId" class="btn btn-pill btn-soft">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}