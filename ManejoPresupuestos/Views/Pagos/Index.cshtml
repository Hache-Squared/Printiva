@model IEnumerable<ManejoPresupuestos.Models.Pago>
@{
    ViewData["Title"] = "Pagos";
    var cot = (ManejoPresupuestos.Models.CotizacionIndexRow)ViewBag.Cotizacion;
}

<style>
    :root{
        --pg-bg: #F6F7FB;
        --card-bg: rgba(255,255,255,.96);
        --text: #0F172A;
        --muted: #64748B;
        --border: rgba(15,23,42,.08);
        --border2: rgba(15,23,42,.06);
        --primary: #1D4ED8;
        --danger: #EF4444;
    }

    body{ background: var(--pg-bg); }
    .pg-wrap{ max-width: 1180px; }

    .pg-title{
        color: var(--text);
        font-weight: 900;
        letter-spacing: -.02em;
        font-size: clamp(2rem, 1.45rem + 1.25vw, 2.75rem);
        line-height: 1.05;
        margin: 0;
    }
    .pg-subtitle{
        color: var(--muted);
        font-size: .98rem;
        margin-top: .55rem;
        max-width: 90ch;
    }

    .btn-pill{
        border-radius: 999px;
        padding: .56rem 1.02rem;
        font-weight: 850;
        font-size: .92rem;
        white-space: nowrap;
    }
    .btn-pill.btn-sm{
        padding: .40rem .78rem;
        font-size: .84rem;
    }
    .btn-primary-pill{
        background: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 12px 24px rgba(29,78,216,.16);
    }
    .btn-soft{
        border-color: rgba(100,116,139,.35);
        color: #0F172A;
        background: rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background: rgba(255,255,255,.92);
        border-color: rgba(100,116,139,.45);
    }
    .btn-danger-soft{
        background: rgba(239,68,68,.10);
        border-color: rgba(239,68,68,.20);
        color: #B91C1C;
    }
    .btn-danger-soft:hover{
        background: rgba(239,68,68,.14);
        border-color: rgba(239,68,68,.24);
        color: #991B1B;
    }

    .card-soft{
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(2,6,23,.08);
    }

    .table-clean{ margin: 0; }
    .table-clean thead th{
        color: var(--muted);
        font-weight: 850;
        letter-spacing: .14em;
        font-size: .72rem;
        text-transform: uppercase;
        padding: .70rem .90rem;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
        vertical-align: middle;
    }
    .table-clean tbody td{
        padding: .58rem .90rem;
        border-top: 1px solid rgba(15,23,42,.06);
        vertical-align: middle;
        font-size: .95rem;
    }

    .badge-soft{
        border-radius: 999px;
        padding: .32rem .56rem;
        font-weight: 900;
        font-size: .78rem;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(15,23,42,.03);
        color: var(--text);
        white-space: nowrap;
    }
    .money{ font-weight: 900; color: var(--text); }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Pagos</h1>
                <div class="pg-subtitle">
                    Cotización #@cot.CotizacionId · Total $@cot.TotalCotizado.ToString("0.00") · Saldo $@cot.Saldo.ToString("0.00")
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Cotizaciones" asp-action="Detalles" asp-route-id="@cot.CotizacionId" class="btn btn-pill btn-soft">Volver</a>
                <a asp-action="Crear" asp-route-cotizacionId="@cot.CotizacionId" class="btn btn-primary btn-pill btn-primary-pill">Registrar pago</a>
            </div>
        </div>

        <div class="card card-soft">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-clean align-middle">
                        <thead>
                            <tr>
                                <th style="width:120px;">Fecha</th>
                                <th style="width:140px;">Tipo</th>
                                <th style="min-width:180px;">Método</th>
                                <th style="min-width:180px;">Referencia</th>
                                <th class="text-end" style="width:130px;">Monto</th>
                                <th style="width:170px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge badge-soft">@p.PagoTipo</span></td>
                                <td>@(string.IsNullOrWhiteSpace(p.Metodo) ? "-" : p.Metodo)</td>
                                <td>@(string.IsNullOrWhiteSpace(p.Referencia) ? "-" : p.Referencia)</td>
                                <td class="text-end money">$@p.Monto.ToString("0.00")</td>
                                <td style="white-space:nowrap;">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a class="btn btn-pill btn-soft btn-sm"
                                           asp-action="Editar"
                                           asp-route-cotizacionId="@p.CotizacionId"
                                           asp-route-id="@p.PagoId">
                                            Editar
                                        </a>
                                        <a class="btn btn-pill btn-danger-soft btn-sm"
                                           asp-action="Borrar"
                                           asp-route-cotizacionId="@p.CotizacionId"
                                           asp-route-id="@p.PagoId">
                                            Borrar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>