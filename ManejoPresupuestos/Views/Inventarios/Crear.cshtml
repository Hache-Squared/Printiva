@model InventarioCreacionViewModel;
@{
    ViewData["Title"] = "Crear Inventario";
}

<style>
    :root{
        --pg-bg:#F6F7FB;
        --card-bg:rgba(255,255,255,.96);
        --text:#0F172A;
        --muted:#64748B;
        --border:rgba(15,23,42,.08);
        --border2:rgba(15,23,42,.06);
        --primary:#1D4ED8;
    }

    body{ background:var(--pg-bg); }

    .pg-wrap{ max-width: 980px; }

    .pg-title{
        color:var(--text);
        font-weight:850;
        letter-spacing:-.02em;
        font-size:clamp(2rem, 1.5rem + 1.1vw, 2.55rem);
        line-height:1.05;
        margin:0;
    }
    .pg-subtitle{
        color:var(--muted);
        font-size:.98rem;
        margin-top:.55rem;
        max-width:80ch;
    }

    .card-soft{
        background:var(--card-bg);
        border:1px solid var(--border);
        border-radius:18px;
        box-shadow:0 10px 30px rgba(2,6,23,.08);
    }

    .btn-pill{
        border-radius:999px;
        padding:.58rem 1.02rem;
        font-weight:800;
        font-size:.92rem;
        white-space:nowrap;
    }
    .btn-soft{
        border-color:rgba(100,116,139,.35);
        color:#0F172A;
        background:rgba(255,255,255,.75);
    }
    .btn-soft:hover{
        background:rgba(255,255,255,.92);
        border-color:rgba(100,116,139,.45);
    }
    .btn-primary-pill{
        background:var(--primary);
        border-color:var(--primary);
        box-shadow:0 12px 24px rgba(29,78,216,.16);
    }

    .form-label{
        color:var(--text);
        font-weight:750;
        margin-bottom:.45rem;
    }
    .control-soft{
        border-radius:12px;
        border-color:rgba(15,23,42,.10);
        background:rgba(15,23,42,.03);
        padding-top:.72rem;
        padding-bottom:.72rem;
    }
    .control-soft:focus{
        border-color:rgba(29,78,216,.40);
        box-shadow:0 0 0 .25rem rgba(29,78,216,.12);
        background:#fff;
    }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Crear inventario</h1>
                <div class="pg-subtitle">Un registro de inventario se refiere a indicar alguna entrada de mercancía o material.</div>
            </div>

            <a asp-action="Index" class="btn btn-pill btn-soft">Volver</a>
        </div>

        <div class="card card-soft">
            <div class="card-body p-4 p-md-4">
                <form asp-action="Crear" class="">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="InventarioMarcaId" class="form-label"></label>
                            <select asp-for="InventarioMarcaId" asp-items="@Model.Marcas" class="form-select control-soft"></select>
                            <span asp-validation-for="InventarioMarcaId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InventarioTipoId" class="form-label"></label>
                            <select asp-for="InventarioTipoId" asp-items="@Model.Tipos" class="form-select control-soft"></select>
                            <span asp-validation-for="InventarioTipoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InventarioNombreId" class="form-label"></label>
                            <select asp-for="InventarioNombreId" asp-items="@Model.Nombres" class="form-select control-soft"></select>
                            <span asp-validation-for="InventarioNombreId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InventarioColorId" class="form-label"></label>
                            <select asp-for="InventarioColorId" asp-items="@Model.Colores" class="form-select control-soft"></select>
                            <span asp-validation-for="InventarioColorId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="InventarioUnidadId" class="form-label"></label>
                            <select asp-for="InventarioUnidadId" asp-items="@Model.Unidades" class="form-select control-soft"></select>
                            <span asp-validation-for="InventarioUnidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label"></label>
                            <input asp-for="Cantidad" class="form-control control-soft" />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaCreacion" class="form-label"></label>
                            <input asp-for="FechaCreacion" class="form-control control-soft" />
                            <span asp-validation-for="FechaCreacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        <button class="btn btn-primary btn-pill btn-primary-pill" type="submit">Enviar</button>
                        <a asp-action="Index" class="btn btn-pill btn-soft">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}