@model InventarioTipo;
@{
    ViewData["Title"] = "Borrar Tipo de Inventario";
}

<style>
    :root{
        --pg-bg:#F6F7FB; --card-bg:rgba(255,255,255,.96);
        --text:#0F172A; --muted:#64748B;
        --border:rgba(15,23,42,.08); --danger:#EF4444;
    }
    body{ background:var(--pg-bg); }
    .pg-wrap{ max-width: 780px; }
    .pg-title{ color:var(--text); font-weight:850; letter-spacing:-.02em; font-size:clamp(2rem, 1.5rem + 1.05vw, 2.35rem); line-height:1.05; margin:0; }
    .pg-subtitle{ color:var(--muted); font-size:.98rem; margin-top:.55rem; max-width:75ch; }
    .card-soft{ background:var(--card-bg); border:1px solid var(--border); border-radius:18px; box-shadow:0 10px 30px rgba(2,6,23,.08); }
    .btn-pill{ border-radius:999px; padding:.58rem 1.02rem; font-weight:800; font-size:.92rem; white-space:nowrap; }
    .btn-soft{ border-color:rgba(100,116,139,.35); color:#0F172A; background:rgba(255,255,255,.75); }
    .btn-soft:hover{ background:rgba(255,255,255,.92); border-color:rgba(100,116,139,.45); }
    .btn-danger-pill{ background:var(--danger); border-color:var(--danger); box-shadow:0 12px 24px rgba(239,68,68,.18); }
    .warn-box{ background:rgba(239,68,68,.06); border:1px solid rgba(239,68,68,.18); border-radius:14px; padding:.95rem 1rem; color:#991B1B; font-weight:700; }
</style>

<div class="container-xxl py-4">
    <div class="pg-wrap mx-auto">

        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
            <div>
                <h1 class="pg-title">Borrar tipo</h1>
                <div class="pg-subtitle">Confirma la eliminación del tipo de inventario.</div>
            </div>
            <a asp-action="Tipos" class="btn btn-pill btn-soft">Volver</a>
        </div>

        <div class="card card-soft">
            <div class="card-body p-4 p-md-4">
                <div class="warn-box mb-3">
                    ¿Esta seguro de querer borrar el tipo de inventario @Model.Nombre?
                </div>

                <form asp-action="BorrarTipo">
                    <input type="hidden" asp-for="InventarioTipoId" />

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-danger btn-pill btn-danger-pill" type="submit">Borrar</button>
                        <a asp-action="Tipos" class="btn btn-pill btn-soft">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>