@model InventarioNombre;
@{
	ViewData["Title"] = "Crear Nombre de Inventario";
}

<h1>Crear nombre de inventario</h1>
<h5>
    Un nombre de inventario ayuda a identificar el producto a almacenar.
</h5>

<form asp-action="CrearNombre">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Abreviatura" class="form-label"></label>
        <input asp-for="Abreviatura" class="form-control" />
        <span asp-validation-for="Abreviatura" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">
        Enviar
    </button>
    <a asp-action="Nombres" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}