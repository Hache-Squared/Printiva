@model InventarioColor
@{
    ViewData["Title"] = "Editar Color de Inventario";
}

<h1>Editar color de inventario</h1>

<form asp-action="EditarColor">
    <div asp-validation-summary="ModelOnly" class="text-danger">
    </div>

    <input type="hidden" asp-for="InventarioColorId" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Abreviatura" class="form-label"></label>
        <input asp-for="Abreviatura" class="form-control" />
        <span asp-validation-for="Abreviatura" class="text-danger"></span>
    </div>

    <button class="btn btn-primary" type="submit">
        Enviar
    </button>

    <a asp-action="Colores" class="btn btn-secondary">
        Cancelar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
